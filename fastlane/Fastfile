require "digest"
require "dotenv"
require "fileutils"
require "json"
require "open3"
require "shellwords"
require "tmpdir"
require_relative "release"

# Release's checks stop a lane with fastlane's own error, which prints the
# message without a stack trace.
Release.fail_with { |message| UI.user_error!(message) }

# Actions run from the repo root, but `sh` and Dir.pwd run from ./fastlane,
# so every path below is absolute.
ROOT = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
PACKAGE_JSON = File.join(ROOT, "package.json")
PBXPROJ = File.join(ROOT, "ios/learnX.xcodeproj/project.pbxproj")
GRADLE = File.join(ROOT, "android/app/build.gradle")
ANDROID_APP = File.join(ROOT, "android/app")

GITHUB_REPO = "robertying/learnX"
APP_IDENTIFIER = "io.robertying.learnX"
# The Appfile sets this only for `android` lanes; the top-level `release` and
# `bump` lanes need it too.
ANDROID_PACKAGE = "io.robertying.learnx"
APK_ABIS = %w[x86_64 arm64-v8a armeabi-v7a universal].freeze

skip_docs

# ---------------------------------------------------------------------------
# Versions

def app_version
  JSON.parse(File.read(PACKAGE_JSON))["version"]
end

def build_numbers
  Release.build_numbers(File.read(PBXPROJ))
end

def build_number
  build_numbers.max
end

def android_version_code
  Release.android_version_code(build_number)
end

def verify_versions!
  problems = Release.version_problems(app_version, File.read(PBXPROJ), File.read(GRADLE))
  return if problems.empty?

  UI.user_error!("#{problems.join(', ')} out of sync with package.json #{app_version} (build #{build_number}). Run `bundle exec fastlane bump`.")
end

# ---------------------------------------------------------------------------
# Paths

def out_dir
  File.join(ROOT, "build/release/v#{app_version}")
end

def sourcemap_path(platform)
  build = platform == "android" ? android_version_code : build_number
  File.join(out_dir, "sourcemaps", "learnX-#{platform}-v#{app_version}-#{build}.map")
end

# Removes the platform's maps from earlier builds of this version, so the
# GitHub release's zip has only the maps of the binaries it ships.
def clear_sourcemaps(platform)
  Dir[File.join(out_dir, "sourcemaps", "learnX-#{platform}-v#{app_version}-*.map")].each { |map| FileUtils.rm_f(map) }
end

# ---------------------------------------------------------------------------
# Build records (Release.build_record says what they hold)

def head_commit
  Dir.chdir(ROOT) { `git rev-parse HEAD`.strip }
end

def tree_dirty?
  Dir.chdir(ROOT) { !`git status --porcelain`.strip.empty? }
end

def build_record_path(platform)
  File.join(out_dir, platform, "build.json")
end

def start_build_record(platform)
  FileUtils.rm_f(build_record_path(platform))
  { commit: head_commit, dirty: tree_dirty? }
end

def write_build_record(platform, started, files, extra = {})
  record = Release.build_record(
    platform: platform, version: app_version, build: build_number,
    commit: started[:commit], dirty: started[:dirty], out_dir: out_dir, files: files, extra: extra,
  )
  FileUtils.mkdir_p(File.dirname(build_record_path(platform)))
  File.write(build_record_path(platform), "#{JSON.pretty_generate(record)}\n")
end

def build_record(platform)
  path = build_record_path(platform)
  File.exist?(path) ? JSON.parse(File.read(path)) : nil
end

# Why the platform's build can't be uploaded from this checkout, or nil.
def build_record_problem(platform)
  Release.build_record_problem(
    build_record(platform),
    platform: platform, version: app_version, build: build_number, head: head_commit, out_dir: out_dir,
  )
end

def verify_built!(platform)
  problem = build_record_problem(platform)
  UI.user_error!("Can't upload: #{problem}. Run `bundle exec fastlane #{platform == 'macos' ? 'mac' : platform} build` on a clean tree at this commit.") if problem
end

# Builds unless this commit's build is already there (rebuild:true always
# builds), so a release after `fastlane build` uploads what was built.
def built_or_build(platform, options)
  problem = rebuild?(options) ? "rebuild:true" : build_record_problem(platform)
  if problem.nil?
    UI.success("Using the #{platform} build from #{build_record_path(platform)}")
    return
  end
  UI.message("Building #{platform}: #{problem}")
  case platform
  when "ios", "macos" then build_apple(platform)
  when "android" then build_android
  when "electron" then build_electron(options)
  end
end

def rebuild?(options)
  %w[true yes 1].include?(options[:rebuild].to_s.downcase)
end

def apple_package_path(platform)
  File.join(out_dir, platform, platform == "macos" ? "learnX.pkg" : "learnX.ipa")
end

# ---------------------------------------------------------------------------
# Release notes (written by the release-notes skill, read by
# Release.parse_notes)

def default_notes_path
  File.join(out_dir, "release-notes.md")
end

# notes:<file> if given, else what `fastlane notes` wrote for this version.
def notes_path(options)
  return nil if no_notes?(options)
  return options[:notes] unless options[:notes].to_s.empty?
  return nil unless File.exist?(default_notes_path)

  UI.message("Using release notes from #{default_notes_path}")
  default_notes_path
end

# notes:none uploads no text anywhere (a rebuild between releases).
def no_notes?(options)
  options[:notes].to_s == "none"
end

# store_notes:false keeps the stores' text as it is (set by hand in App Store
# Connect or Play Console) and still gives the GitHub release its notes.
def store_notes?(options)
  !Release.off?(options[:store_notes])
end

# A store's part of the notes, or nil when that store keeps its own text.
def store_text(notes, key, options)
  notes && store_notes?(options) ? notes[key] : nil
end

# What the release lanes upload. With no notes file yet, an interactive run
# writes one (as `fastlane notes` does) and waits until it's reviewed, and a
# non-interactive run stops: notes:none uploads none. A rebuild of a tagged
# version uploads without notes.
def notes_for_release(options)
  path = notes_path(options)
  if path.nil? && !no_notes?(options) && !tagged?(app_version)
    unless UI.interactive?
      UI.user_error!("No release notes for v#{app_version} at #{default_notes_path}: run `bundle exec fastlane notes` and review them, or pass notes:none to upload no text (store_notes:false keeps the stores' text but fills the GitHub release).")
    end
    UI.important("No release notes for v#{app_version} yet, so writing them first.")
    path = write_notes(use_claude: use_claude?(options))
    print_notes(path)
    unless UI.confirm("Edit #{path} if needed. Upload with these notes?")
      UI.user_error!("Stopped before building. Edit #{path}, then run the lane again.")
    end
  end
  release_notes(path)
end

def release_notes(path)
  return nil if path.nil? || path.empty?

  file = File.expand_path(path, ROOT)
  UI.user_error!("Release notes not found: #{file}") unless File.exist?(file)
  Release.parse_notes(File.read(file, encoding: "UTF-8"), file)
end

# claude:false skips Claude Code (fastlane may pass the string).
def use_claude?(options)
  !Release.off?(options[:claude])
end

# Publishing a draft GitHub release makes its tag on GitHub, so a checkout
# that hasn't fetched since has no tag for the last release.
def fetch_tags
  return if @tags_fetched

  @tags_fetched = true
  return if Dir.chdir(ROOT) { system("git", "fetch", "-q", "--tags", "origin") }

  UI.important("Couldn't fetch tags from origin, so the last release may be missing: going by the local tags")
end

# The newest release tag, as the release-notes skill finds it.
def last_release_tag
  fetch_tags
  Dir.chdir(ROOT) { `git tag --list 'v*' --sort=-creatordate`.lines.map(&:strip) }.first
end

def tagged?(version)
  fetch_tags
  Dir.chdir(ROOT) { system("git rev-parse -q --verify refs/tags/v#{version} > /dev/null") }
end

# Writes default_notes_path with Claude Code, or the fallback draft when
# use_claude is false or Claude Code isn't available or fails.
def write_notes(use_claude: true)
  if tagged?(app_version)
    UI.user_error!("v#{app_version} is already released. Run `bundle exec fastlane bump version:x.y.z` first, so the notes are for the next version.")
  end
  path = default_notes_path
  FileUtils.mkdir_p(File.dirname(path))
  FileUtils.rm_f(path)

  if use_claude && write_notes_with_claude(path)
    release_notes(path)
    UI.success("Claude Code wrote the release notes: #{path}")
  else
    write_fallback_notes(path)
    UI.important("Wrote a draft from the commit list instead: #{path}")
    UI.important("Fill in every #{Release::NOTES_TODO}; the release lanes won't upload notes that still have one.")
  end
  path
end

def write_notes_with_claude(path)
  unless system("command -v claude > /dev/null")
    UI.important("The `claude` CLI isn't on PATH (install Claude Code from https://code.claude.com and log in with `claude` once).")
    return false
  end

  prompt = <<~PROMPT
    Use the release-notes skill to write the release notes for learnX v#{app_version}.
    Save the file to #{path} instead of the scratchpad. Don't publish or upload anything.
    This runs unattended, so don't stop to ask: make the best call, and list anything unsure in your reply.
  PROMPT
  # Read-only git and gh (and fetching tags, as the skill does first), plus
  # writing the notes file.
  allowed = [
    "Skill", "Read", "Grep", "Glob", "Write", "Edit",
    "Bash(git fetch --tags:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git tag:*)", "Bash(git describe:*)", "Bash(git diff:*)",
    "Bash(gh release list:*)", "Bash(gh release view:*)",
  ]
  # claude -p waits for stdin when it isn't a terminal, so give it none.
  command = ["claude", "-p", prompt, "--allowedTools", allowed.join(",")].shelljoin
  UI.message("Running Claude Code with the release-notes skill (takes a few minutes)…")
  ok = Dir.chdir(ROOT) { system("#{command} < /dev/null") }
  unless ok
    UI.important("Claude Code failed (exit #{$?.exitstatus}). Not logged in? Run `claude` once to check.")
    return false
  end
  return true if File.exist?(path)

  UI.important("Claude Code finished but wrote no notes to #{path}.")
  false
end

# The release-notes shape with the commits since the last tag, for a person
# to sort and translate.
def write_fallback_notes(path)
  tag = last_release_tag
  range = tag ? "#{tag}..HEAD" : "HEAD"
  log = Dir.chdir(ROOT) { `git log --no-merges --format=%s #{range.shellescape}` }
  File.write(path, Release.fallback_notes(log.lines, tag))
end

def print_notes(path)
  UI.header("Release notes v#{app_version}")
  puts(File.read(path))
end

# ---------------------------------------------------------------------------
# .env secrets

# The mock login, which every release build inlines from the repo-root .env
# (babel/inline-env.js) for store reviewers and testers. A build without it
# still runs, but the mock login goes to the real SSO login.
RELEASE_ENV_KEYS = %w[DUMMY_USERNAME DUMMY_PASSWORD].freeze

def release_env_file
  File.join(ROOT, ".env")
end

# The over-the-air update URL in app.json; a build with the placeholder would
# never get an update (AGENTS.md).
def verify_ota_config!
  url = JSON.parse(File.read(File.join(ROOT, "app.json"))).dig("updates", "url").to_s
  UI.user_error!("app.json has no real over-the-air update URL (#{url.inspect}); see AGENTS.md") unless url.start_with?("https://") && !url.include?("example.invalid")
end

# Run before a release build, so a checkout without .env (a fresh worktree
# has none: it's git-ignored) fails in seconds instead of shipping a build
# without the mock login.
def verify_release_env!
  # A TEST_LOGIN bundle takes a test login from launch arguments: E2E only.
  UI.user_error!("TEST_LOGIN is set: unset it; it's for E2E builds only") unless ENV["TEST_LOGIN"].to_s.empty?
  UI.user_error!("No .env at #{release_env_file}: copy it from the main checkout (a worktree has none). Release builds inline #{RELEASE_ENV_KEYS.join(', ')} from it.") unless File.exist?(release_env_file)

  env = Dotenv.parse(release_env_file)
  missing = RELEASE_ENV_KEYS.select { |key| env[key].to_s.empty? }
  UI.user_error!("#{release_env_file} has no value for #{missing.join(', ')}, which release builds inline.") unless missing.empty?
end

# Fail the build unless each release bundle has the mock login in it and no
# other .env value (scripts/checks/check-bundle-env.mjs, which CI's release bundle
# check runs too).
def check_bundle_env!(bundles)
  UI.user_error!("Found no JS bundle to check for .env values") if bundles.empty?

  sh("node", File.join(ROOT, "scripts/checks/check-bundle-env.mjs"), *bundles)
end

# ---------------------------------------------------------------------------
# App Store Connect

# Uses an App Store Connect API key when APP_STORE_CONNECT_API_KEY_KEY_ID,
# _ISSUER_ID and _KEY_FILEPATH are set (fastlane/.env); otherwise fastlane
# signs in with an Apple ID and Xcode uses the account in its settings.
def asc_api_key?
  !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s.empty?
end

def xcode_auth_args
  return [] unless asc_api_key?

  [
    "-authenticationKeyPath", File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")),
    "-authenticationKeyID", ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
    "-authenticationKeyIssuerID", ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
  ]
end

# platform: "ios" or "macos" (Mac Catalyst). Returns the .ipa / .pkg path.
def build_apple(platform)
  verify_versions!
  verify_release_env!
  verify_ota_config!
  started = start_build_record(platform)
  clear_sourcemaps(platform)
  map = sourcemap_path(platform)
  FileUtils.mkdir_p(File.dirname(map))

  # react-native-xcode.sh writes the composed Hermes source map to SOURCEMAP_FILE.
  # gym passes xcargs to the export too, so the auth args must not also go in export_xcargs.
  xcargs = ["-allowProvisioningUpdates", *xcode_auth_args, "SOURCEMAP_FILE=#{map}"]
  options = {
    workspace: File.join(ROOT, "ios/learnX.xcworkspace"),
    scheme: "learnX",
    configuration: "Release",
    clean: true,
    export_method: "app-store",
    export_options: { signingStyle: "automatic" },
    xcargs: xcargs.shelljoin,
    output_directory: File.join(out_dir, platform),
    output_name: "learnX",
  }
  options[:catalyst_platform] = "macos" if platform == "macos"
  path = build_app(options)

  archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
  check_bundle_env!(Dir[File.join(archive.to_s, "Products/Applications/*.app/**/main.jsbundle")])

  UI.user_error!("The build wrote no source map to #{map}") unless File.exist?(map)
  UI.success("Source map: #{map}")

  # Every dSYM in the archive (the app's and its extensions'), zipped next to
  # the .ipa / .pkg. Not gym's learnX.app.dSYM.zip: gym writes none for a
  # Mac Catalyst export.
  archived = Dir[File.join(archive.to_s, "dSYMs/*.dSYM")]
  # Without the app's own dSYM, Crashlytics can't symbolicate the app's frames
  # (19.0.0's Mac archive had only the extensions' and frameworks' dSYMs).
  UI.user_error!("The archive #{archive} has no learnX.app.dSYM") unless archived.any? { |dsym| File.basename(dsym) == "learnX.app.dSYM" }
  dsyms = dsym_zip_path(platform)
  FileUtils.rm_f(dsyms)
  sh("ditto", "-c", "-k", File.join(archive.to_s, "dSYMs"), dsyms)
  upload_dsyms(platform, dsyms)
  write_build_record(platform, started, [path, map, dsyms])
  path
end

def dsym_zip_path(platform)
  File.join(out_dir, platform, "learnX-dSYMs.zip")
end

# Firebase's upload-symbols, from the firebase-ios-sdk Swift package that the
# build checked out next to its build folder (as the "Upload dSYM files" build
# phase finds Crashlytics/run).
def crashlytics_upload_symbols
  @crashlytics_upload_symbols ||= begin
    # stdout only: xcodebuild warns on stderr.
    out, status = Open3.capture2(
      "xcodebuild", "-showBuildSettings", "-json",
      "-workspace", File.join(ROOT, "ios/learnX.xcworkspace"), "-scheme", "learnX", "-configuration", "Release",
    )
    UI.user_error!("xcodebuild -showBuildSettings failed") unless status.success?
    settings = JSON.parse(out)
    build_dir = settings.map { |target| target.dig("buildSettings", "BUILD_DIR") }.compact.first.to_s
    path = File.join(build_dir.sub(%r{\A(.*)/Build/.*\z}, "\\1"), "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")
    UI.user_error!("Found no Crashlytics upload-symbols at #{path}: build the app first, so Xcode checks out the Firebase package") unless File.executable?(path)
    path
  end
end

# Uploads the build's dSYMs to Crashlytics, so it symbolicates native frames.
# The "Upload dSYM files" build phase uploads them too, but in the background,
# where a failed upload goes unnoticed (18.0.3's Mac dSYMs never arrived); this
# one fails the lane, as the Android build does.
# platform: "ios" or "macos" (Mac Catalyst, which Crashlytics calls mac).
def upload_dsyms(platform, dsyms)
  sh(
    crashlytics_upload_symbols,
    "-gsp", File.join(ROOT, "ios/GoogleService-Info.plist"),
    "-p", platform == "macos" ? "mac" : "ios",
    dsyms,
  )
  UI.success("Uploaded the dSYMs to Crashlytics: #{dsyms}")
end

# Uploads the dSYMs of this version's build again, from build/release.
def upload_built_dsyms(platform)
  dsyms = dsym_zip_path(platform)
  UI.user_error!("No dSYMs at #{dsyms}: run `bundle exec fastlane #{platform == 'macos' ? 'mac' : 'ios'} build` first") unless File.exist?(dsyms)
  upload_dsyms(platform, dsyms)
end

def upload_apple(platform, path, notes)
  app_store_connect_api_key if asc_api_key?
  Dir.mktmpdir do |metadata|
    options = {
      app_version: app_version,
      platform: platform == "macos" ? "osx" : "ios",
      metadata_path: metadata,
      skip_screenshots: true,
      skip_metadata: notes.nil?,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    }
    options[platform == "macos" ? :pkg : :ipa] = path
    options[:release_notes] = { "en-US" => notes[:en], "zh-Hans" => notes[:zh] } if notes
    upload_to_app_store(options)
  end
  return unless notes

  label = platform == "macos" ? "mac" : "ios"
  UI.important("Once App Store Connect has processed build #{build_number}, set its TestFlight What to Test to these notes: bundle exec fastlane #{label} testflight_notes")
end

# TestFlight's What to Test for a build that App Store Connect has processed:
# the same notes as the store's What's New, or what_to_test: (one text for
# both languages) for a build between releases, which has no notes yet.
def what_to_test(options, section)
  text = options[:what_to_test].to_s.strip
  return { en: text, zh: text } unless text.empty?

  notes = release_notes(notes_path(options))
  UI.user_error!("No release notes for v#{app_version}: pass notes:<file> or what_to_test:<text>, or run `bundle exec fastlane notes`") unless notes
  notes[section]
end

# Sets What to Test on an uploaded build. With groups, also submits it for
# Beta App Review and adds it to those external groups, whose testers get it
# once Apple approves it (a build of a version Apple has already approved
# may go out at once).
def distribute_testflight(platform, build, notes, groups: nil)
  app_store_connect_api_key if asc_api_key?
  options = {
    distribute_only: true,
    app_platform: platform == "macos" ? "osx" : "ios",
    app_version: app_version,
    build_number: build.to_s,
    localized_build_info: {
      "en-US" => { whats_new: notes[:en] },
      "zh-Hans" => { whats_new: notes[:zh] },
    },
  }
  if groups
    options.merge!(distribute_external: true, submit_beta_review: true, groups: groups)
  else
    options[:skip_submission] = true
  end
  upload_to_testflight(options)
end

# groups: if given, else TESTFLIGHT_EXTERNAL_GROUPS in fastlane/.env
# (comma-separated names of the app's external TestFlight groups).
def external_groups(options)
  groups = (options[:groups] || ENV["TESTFLIGHT_EXTERNAL_GROUPS"]).to_s.split(",").map(&:strip).reject(&:empty?)
  UI.user_error!("No external TestFlight groups: pass groups:<name,...> or set TESTFLIGHT_EXTERNAL_GROUPS in fastlane/.env") if groups.empty?
  groups
end

def submit_for_beta_review(platform, section, options)
  build = options[:build] || build_number
  notes = what_to_test(options, section)
  groups = external_groups(options)
  label = platform == "macos" ? "Mac" : "iOS"
  UI.important("Submitting #{label} build #{build} (v#{app_version}) for Beta App Review, for the external groups #{groups.join(', ')}.")
  UI.user_error!("Stopped before submitting.") if UI.interactive? && !UI.confirm("Submit?")
  distribute_testflight(platform, build, notes, groups: groups)
end

# ---------------------------------------------------------------------------
# Android

def android_out_dir
  File.join(out_dir, "android")
end

def aab_path
  File.join(android_out_dir, "learnX-v#{app_version}.aab")
end

def apk_paths
  APK_ABIS.map { |abi| File.join(android_out_dir, "learnX-#{abi}-v#{app_version}.apk") }
end

def latest_json_path
  File.join(android_out_dir, "latest.json")
end

# R8's mapping for the AAB, which Google Play needs to deobfuscate the
# crashes and ANRs it reports (Crashlytics gets it from the Gradle plugin).
def aab_mapping_path
  File.join(android_out_dir, "learnX-v#{app_version}-mapping.txt")
end

def build_android
  verify_versions!
  verify_release_env!
  verify_ota_config!
  started = start_build_record("android")
  # The release config reads LEARNX_RELEASE_* from android/local.properties and
  # signs with android/app/release.keystore. Two flavors (android/app/build.gradle):
  # googlePlay makes the AAB, github the APKs that update themselves in the app.
  # Separate runs: ABI splits are off while building an AAB (android/app/build.gradle).
  gradle(
    project_dir: File.join(ROOT, "android"),
    tasks: ["app:bundleGooglePlayRelease", "app:uploadCrashlyticsSymbolFileGooglePlayRelease"],
  )
  gradle(
    project_dir: File.join(ROOT, "android"),
    tasks: ["app:assembleGithubRelease", "app:uploadCrashlyticsSymbolFileGithubRelease"],
  )

  check_bundle_env!(Dir[File.join(ANDROID_APP, "build/generated/assets/react/{googlePlayRelease,githubRelease}/index.android.bundle")])

  FileUtils.rm_rf(android_out_dir)
  FileUtils.mkdir_p(android_out_dir)
  FileUtils.cp(File.join(ANDROID_APP, "build/outputs/bundle/googlePlayRelease/app-googlePlay-release.aab"), aab_path)
  mapping = File.join(ANDROID_APP, "build/outputs/mapping/googlePlayRelease/mapping.txt")
  UI.user_error!("The AAB build wrote no R8 mapping at #{mapping}") unless File.exist?(mapping)
  FileUtils.cp(mapping, aab_mapping_path)

  # APKs for GitHub Releases and the TUNA mirror. The app's updater reads
  # latest.json from the mirror, downloads learnX-<abi>-v<version>.apk and
  # checks it against the SHA-256 here before installing it; the size is shown
  # when it asks to update.
  files = APK_ABIS.zip(apk_paths).map do |abi, dest|
    FileUtils.cp(File.join(ANDROID_APP, "build/outputs/apk/github/release/app-github-#{abi}-release.apk"), dest)
    { name: File.basename(dest), size: File.size(dest), sha256: Digest::SHA256.file(dest).hexdigest }
  end
  File.write(latest_json_path, "#{JSON.pretty_generate({ version: app_version, files: files })}\n")

  # Both flavors bundle the same JS, so one map decodes either's crashes.
  maps = %w[googlePlayRelease githubRelease].map do |variant|
    File.join(ANDROID_APP, "build/generated/sourcemaps/react/#{variant}/index.android.bundle.map")
  end
  UI.user_error!("The googlePlay and github JS bundles differ; keep both source maps.") unless FileUtils.compare_file(*maps)
  clear_sourcemaps("android")
  map = sourcemap_path("android")
  FileUtils.mkdir_p(File.dirname(map))
  FileUtils.cp(maps.first, map)
  write_build_record("android", started, [aab_path, aab_mapping_path, *apk_paths, latest_json_path, map])

  UI.success("Android release files: #{android_out_dir}")
  UI.success("Source map: #{map}")
end

# LEARNX_RELEASE_* signing values from android/local.properties, which the
# release build reads too.
def android_signing
  path = File.join(ROOT, "android/local.properties")
  UI.user_error!("No #{path} with the LEARNX_RELEASE_* signing values.") unless File.exist?(path)
  File.readlines(path, chomp: true).each_with_object({}) do |line, values|
    key, value = line.split("=", 2)
    values[key.strip] = value.strip if value && key.strip.start_with?("LEARNX_RELEASE_")
  end
end

# Installs the AAB from `android build` on the connected device the way Google
# Play would: bundletool picks the APKs for that device.
def install_android_bundle
  UI.user_error!("No AAB at #{aab_path}. Run `bundle exec fastlane android build` first.") unless File.exist?(aab_path)
  UI.user_error!("bundletool not found: brew install bundletool") unless system("command -v bundletool > /dev/null")
  signing = android_signing
  apks = aab_path.sub(/\.aab\z/, ".apks")
  # The passwords go in files only this user can read, not in the command
  # line, which every process on the Mac can see.
  Dir.mktmpdir do |dir|
    passwords = %w[STORE KEY].to_h do |name|
      file = File.join(dir, name.downcase)
      File.write(file, signing["LEARNX_RELEASE_#{name}_PASSWORD"], perm: 0o600)
      [name, file]
    end
    sh(
      "bundletool", "build-apks", "--connected-device", "--overwrite",
      "--bundle=#{aab_path}", "--output=#{apks}",
      "--ks=#{File.join(ANDROID_APP, "release.keystore")}",
      "--ks-key-alias=#{signing["LEARNX_RELEASE_KEY_ALIAS"]}",
      "--ks-pass=file:#{passwords["STORE"]}",
      "--key-pass=file:#{passwords["KEY"]}",
    )
  end
  sh("bundletool", "install-apks", "--apks=#{apks}")
end

def upload_android(notes, track)
  UI.user_error!("No AAB at #{aab_path}. Run `bundle exec fastlane android build` first.") unless File.exist?(aab_path)

  Dir.mktmpdir do |metadata|
    if notes
      { "en-US" => notes[:en], "zh-CN" => notes[:zh] }.each do |locale, text|
        dir = File.join(metadata, locale, "changelogs")
        FileUtils.mkdir_p(dir)
        File.write(File.join(dir, "#{android_version_code}.txt"), text)
      end
    end

    options = {
      aab: aab_path,
      mapping: aab_mapping_path,
      package_name: ANDROID_PACKAGE,
      track: track,
      # A draft release: review and roll it out in Play Console.
      release_status: "draft",
      metadata_path: metadata,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: notes.nil?,
    }
    options[:json_key] = play_json_key if play_json_key
    upload_to_play_store(options)
  end
end

# ---------------------------------------------------------------------------
# Electron (Windows and Linux)
#
# This Mac builds the installers (electron-builder's tools run natively on
# Apple silicon, no Rosetta), or installers built elsewhere
# (`pnpm electron:package --win` on a Windows PC, `--linux` on Linux) are
# copied in with `from:`. Either way the lane checks them against this
# commit's version before signing and uploading.

def electron_out_dir
  File.join(out_dir, "electron")
end

def electron_platforms(options)
  Release.electron_platforms(options[:platforms])
end

def electron_update_file_paths(platforms)
  platforms.flat_map { |platform| Release::ELECTRON_PLATFORMS[platform] }.map { |name| File.join(electron_out_dir, name) }
end

# Every update file is for this version, and every installer it names is
# here with that SHA-512 (Release.electron_file_problems).
def verify_electron_files!(platforms)
  problems = Release.electron_file_problems(electron_out_dir, platforms, app_version)
  UI.user_error!("Electron release files in #{electron_out_dir}: #{problems.join('; ')}") unless problems.empty?
end

# The release files of a folder: update files, installers and blockmaps.
def electron_release_files(dir)
  Dir[File.join(dir, "{latest*.yml,*.exe,*.AppImage,*.deb,*.blockmap}")].sort
end

# Fills build/release/v<version>/electron/: copied from `from:` (folders of
# installers built on a Windows PC or Linux, comma-separated), or packaged
# here with the release .env's mock login, as the mobile release bundles are.
def build_electron(options)
  verify_versions!
  platforms = electron_platforms(options)
  started = start_build_record("electron")
  FileUtils.rm_rf(electron_out_dir)
  FileUtils.mkdir_p(electron_out_dir)

  if options[:from]
    options[:from].to_s.split(",").map { |dir| File.expand_path(dir.strip) }.each do |dir|
      files = electron_release_files(dir)
      UI.user_error!("No installers or latest*.yml in #{dir}") if files.empty?
      FileUtils.cp(files, electron_out_dir)
    end
  else
    verify_release_env!
    flags = platforms.map { |platform| "--#{platform}" }
    # Outside Bundler's environment: its RUBYOPT and BUNDLE_GEMFILE would
    # load this Gemfile into the Ruby that electron-builder's fpm (the .deb)
    # brings, which then fails for gems it doesn't have.
    Bundler.with_unbundled_env { sh("pnpm", "electron:package", *flags) }
    check_bundle_env!(Dir[File.join(ROOT, "build/electron/web/_expo/static/js/web/*.js")])
    FileUtils.cp(electron_release_files(File.join(ROOT, "build/electron/dist")), electron_out_dir)
  end

  verify_electron_files!(platforms)
  write_build_record("electron", started, electron_release_files(electron_out_dir), platforms: platforms)
  UI.success("Electron release files for #{platforms.join(', ')} in #{electron_out_dir}")
  platforms
end

# The platforms of this commit's Electron build, which must be the ones asked
# for (all of them unless platforms: says otherwise).
def built_electron_platforms(options)
  verify_built!("electron")
  built = build_record("electron")["platforms"]
  wanted = electron_platforms(options)
  UI.user_error!("The Electron build has #{built.join(', ')}, not #{wanted.join(', ')}: run `bundle exec fastlane electron build platforms:#{wanted.join(',')}`") unless built.sort == wanted.sort
  built
end

def electron_signed?(platforms)
  electron_update_file_paths(platforms).all? { |yml| File.exist?("#{yml}.sig") }
end

# Signs the update files (scripts/release/sign-electron-update.mjs, which refuses one
# for another version), with the key from `key:` or LEARNX_UPDATE_SIGNING_KEY
# (a file), or else read from 1Password with `op read` at
# LEARNX_UPDATE_SIGNING_KEY_REF (an op:// reference, in fastlane/.env), so
# the key never touches the disk.
def sign_electron(options)
  script = File.join(ROOT, "scripts/release/sign-electron-update.mjs")
  key = options[:key] || ENV["LEARNX_UPDATE_SIGNING_KEY"]
  if key && !key.to_s.empty?
    sh("node", script, electron_out_dir, "--key", File.expand_path(key.to_s))
    return
  end
  ref = ENV["LEARNX_UPDATE_SIGNING_KEY_REF"].to_s
  UI.user_error!("No update signing key: pass key:, or set LEARNX_UPDATE_SIGNING_KEY (a file) or LEARNX_UPDATE_SIGNING_KEY_REF (the key's op:// reference) in fastlane/.env") if ref.empty?
  UI.important("1Password asks to approve reading the update signing key now; the prompt gives up after about a minute.")
  sh("bash", "-c", 'node "$0" "$1" --key <(op read "$2")', script, electron_out_dir, ref)
end

# What goes on the GitHub release: every file, each update file with its
# signature. An unsigned update file would be refused by every install.
def electron_assets(platforms)
  verify_electron_files!(platforms)
  unsigned = electron_update_file_paths(platforms).reject { |yml| File.exist?("#{yml}.sig") }
  UI.user_error!("Unsigned: #{unsigned.map { |f| File.basename(f) }.join(', ')}. Run `bundle exec fastlane electron sign`.") unless unsigned.empty?

  electron_release_files(electron_out_dir) + Dir[File.join(electron_out_dir, "latest*.yml.sig")].sort
end

# Adds the files to the draft v<version> release `fastlane release` (or
# `github_release`) made, replacing ones of the same name.
def upload_electron(platforms)
  tag = "v#{app_version}"
  assets = electron_assets(platforms)
  case github_release_state(tag)
  when :none then UI.user_error!("No #{tag} release on GitHub: run `bundle exec fastlane github_release` (or `release`) first")
  when :published then UI.user_error!("#{tag} is published: add Windows and Linux files before publishing, since the TUNA mirror copies a release on its schedule")
  end

  sh("gh", "release", "upload", tag, *assets, "--repo", GITHUB_REPO, "--clobber")
end

# ---------------------------------------------------------------------------
# GitHub Releases

def github_token
  token = ENV["GITHUB_TOKEN"].to_s
  token = sh("gh", "auth", "token", log: false).strip if token.empty?
  token
end

# Whether GitHub has a v<version> release: :none, :draft or :published.
def github_release_state(tag)
  out, err, status = Open3.capture3("gh", "release", "view", tag, "--repo", GITHUB_REPO, "--json", "isDraft", "--jq", ".isDraft")
  Release.github_release_state(tag, status.success?, out, err)
end

def publish_github(notes, electron_platforms: nil)
  version = app_version
  tag = "v#{version}"
  verify_built!("android")
  state = github_release_state(tag)
  UI.user_error!("#{tag} is already published on GitHub; a release can't change it") if state == :published

  assets = [latest_json_path, *apk_paths]
  assets += electron_assets(electron_platforms) if electron_platforms
  # This build's maps only, whatever else an earlier build left there.
  maps = %w[ios macos android].map { |platform| sourcemap_path(platform) }.select { |map| File.exist?(map) }
  unless maps.empty?
    zip = File.join(out_dir, "learnX-sourcemaps-v#{version}.zip")
    FileUtils.rm_f(zip)
    sh("zip", "-j", "-q", zip, *maps)
    assets << zip
  end

  # A draft: check it and publish it on GitHub. The TUNA mirror and the
  # in-app updater only see published releases.
  if state == :none
    set_github_release(
      repository_name: GITHUB_REPO,
      api_token: github_token,
      name: tag,
      tag_name: tag,
      commitish: head_commit,
      description: notes ? notes[:github] : "",
      is_draft: true,
      upload_assets: assets,
    )
    return
  end

  # A draft from an earlier run (GitHub would take a second draft of the same
  # tag): point it at this commit, give it these notes (notes:none keeps its
  # own) and replace its files of the same names.
  UI.important("Updating the draft #{tag} release from an earlier run")
  Dir.mktmpdir do |dir|
    edit = ["gh", "release", "edit", tag, "--repo", GITHUB_REPO, "--target", head_commit]
    if notes
      file = File.join(dir, "notes.md")
      File.write(file, notes[:github])
      edit += ["--notes-file", file]
    end
    sh(*edit)
  end
  sh("gh", "release", "upload", tag, *assets, "--repo", GITHUB_REPO, "--clobber")
end

# ---------------------------------------------------------------------------
# Uploaded builds

PLAY_TRACKS = %w[production beta alpha internal].freeze

# supply reads SUPPLY_JSON_KEY itself; fastlane/.env may use this name instead.
def play_json_key
  key = ENV["GOOGLE_PLAY_CONSOLE_JSON_KEY"].to_s
  key = ENV["SUPPLY_JSON_KEY"].to_s if key.empty?
  key.empty? ? nil : File.expand_path(key)
end

# The highest build number each store has (App Store Connect's iOS and Mac
# builds, Play's version codes on any track, drafts included), and what
# couldn't be checked. Builds uploaded between releases take numbers too, so
# the next build has to be above all of them.
def uploaded_builds
  builds = {}
  errors = []
  if asc_api_key?
    app_store_connect_api_key
    { "ios" => "App Store Connect (iOS)", "osx" => "App Store Connect (Mac)" }.each do |platform, name|
      builds[name] = latest_testflight_build_number(app_identifier: APP_IDENTIFIER, platform: platform, initial_build_number: 0).to_i
    rescue StandardError => e
      errors << "#{name}: #{e.message}"
    end
  else
    errors << "App Store Connect: no APP_STORE_CONNECT_API_KEY_* in fastlane/.env"
  end
  if play_json_key
    codes = PLAY_TRACKS.flat_map do |track|
      google_play_track_version_codes(package_name: ANDROID_PACKAGE, track: track, json_key: play_json_key)
    rescue StandardError => e
      errors << "Google Play (#{track}): #{e.message}"
      []
    end
    builds["Google Play"] = codes.map(&:to_i).max - Release::ANDROID_VERSION_CODE_BASE unless codes.empty?
  else
    errors << "Google Play: no GOOGLE_PLAY_CONSOLE_JSON_KEY or SUPPLY_JSON_KEY in fastlane/.env"
  end
  [builds, errors]
end

# ---------------------------------------------------------------------------
# GitHub checks

# `gh api` takes the repository in its path, every other command --repo.
def gh_json(*args)
  repo = args.first == "api" ? [] : ["--repo", GITHUB_REPO]
  out, err, status = Open3.capture3("gh", *args, *repo)
  raise "gh #{args.first(2).join(' ')} failed: #{err.strip}" unless status.success?

  JSON.parse(out)
end

def origin_main
  Dir.chdir(ROOT) do
    system("git", "fetch", "-q", "origin", "main")
    `git rev-parse origin/main`.strip
  end
end

# Why the release commit's CI isn't green, or nil.
def ci_problem(sha)
  Release.ci_problem(gh_json("api", "repos/#{GITHUB_REPO}/commits/#{sha}/check-runs?per_page=100").fetch("check_runs"), sha)
end

ELECTRON_WORKFLOW = "electron.yml"

def electron_update_runs(sha)
  gh_json("run", "list", "--workflow", ELECTRON_WORKFLOW, "--event", "workflow_dispatch", "--commit", sha, "--json", "databaseId,status,conclusion", "--limit", "20")
end

# Why there's no passing real update (the Electron workflow's Update E2E
# jobs, which only a manual run has) on this commit, or nil.
def electron_update_e2e_problem(sha)
  runs = electron_update_runs(sha)
  return "never run on #{sha[0, 8]}" if runs.empty?

  runs.each do |run|
    return nil if Release.update_e2e_passed?(gh_json("run", "view", run["databaseId"].to_s, "--json", "jobs").fetch("jobs"))
  end
  return "still running on #{sha[0, 8]}" if runs.any? { |run| run["status"] != "completed" }

  "failed on #{sha[0, 8]}"
end

# Starts the Electron workflow by hand on main, which must be this commit,
# and waits for it unless wait:false.
def run_electron_update_e2e(options)
  sha = head_commit
  UI.user_error!("The workflow runs on main's latest commit (#{origin_main[0, 8]}), not HEAD #{sha[0, 8]}: push the release commit first") unless sha == origin_main
  before = electron_update_runs(sha).map { |run| run["databaseId"] }
  sh("gh", "workflow", "run", ELECTRON_WORKFLOW, "--repo", GITHUB_REPO, "--ref", "main")
  run = nil
  30.times do
    sleep(5)
    run = electron_update_runs(sha).find { |r| !before.include?(r["databaseId"]) }
    break if run
  end
  UI.user_error!("Started the workflow but found no run for #{sha[0, 8]}; check https://github.com/#{GITHUB_REPO}/actions/workflows/#{ELECTRON_WORKFLOW}") unless run
  id = run["databaseId"].to_s
  UI.success("Electron update E2E: https://github.com/#{GITHUB_REPO}/actions/runs/#{id}")
  return if Release.off?(options[:wait])

  sh("gh", "run", "watch", id, "--repo", GITHUB_REPO, "--exit-status", "--interval", "60")
end

# ---------------------------------------------------------------------------
# Preflight
#
# Everything a release needs that isn't the build itself, checked in a minute
# so a missing key or a red check stops the release before an hour of
# building, not after it.

# A rough guess for four clean release builds and their DerivedData.
MIN_FREE_GB = 30

def preflight(options)
  results = []
  check = lambda do |name, warn: false, &block|
    problem = begin
      block.call
    rescue StandardError => e
      e.message
    end
    results << [name, problem, warn]
  end
  sha = head_commit
  electron = !Release.off?(options[:electron])

  check.call("Clean tree at a commit on origin/main") do
    next "uncommitted changes (git status)" if tree_dirty?

    Dir.chdir(ROOT) { system("git", "merge-base", "--is-ancestor", sha, origin_main) } ? nil : "HEAD #{sha[0, 8]} isn't on origin/main: push it, since the GitHub release points at it"
  end
  check.call("Versions in sync") { verify_versions! && nil }
  check.call("v#{app_version} not released yet") { tagged?(app_version) ? "v#{app_version} is tagged: run `pnpm bump`" : nil }
  check.call("Build #{build_number} above every uploaded build") do
    uploaded, errors = uploaded_builds
    taken = uploaded.select { |_, build| build >= build_number }
    next "#{taken.map { |name, build| "#{name} has #{build}" }.join(', ')}: run `pnpm bump`, which starts above them" unless taken.empty?
    next "couldn't check #{errors.join('; ')}" unless errors.empty?

    nil
  end
  check.call("CI green on HEAD") { ci_problem(sha) }
  check.call("Repo-root .env with the mock login") { verify_release_env! && nil }
  check.call("Over-the-air update URL in app.json") { verify_ota_config! && nil }
  check.call("Android signing") do
    signing = android_signing
    missing = %w[LEARNX_RELEASE_STORE_PASSWORD LEARNX_RELEASE_KEY_ALIAS LEARNX_RELEASE_KEY_PASSWORD].select { |key| signing[key].to_s.empty? }
    next "android/local.properties has no #{missing.join(', ')}" unless missing.empty?

    File.exist?(File.join(ANDROID_APP, "release.keystore")) ? nil : "no android/app/release.keystore"
  end
  unless no_notes?(options)
    check.call("Release notes") do
      path = notes_path(options)
      next "none for v#{app_version}: run `bundle exec fastlane notes` and review them (or pass notes:none)" unless path

      release_notes(path) && nil
    end
  end
  if app_version.end_with?(".0")
    check.call("What's New entry for v#{app_version}", warn: true) do
      File.read(File.join(ROOT, "src/helpers/whatsNew.ts")).include?("version: '#{app_version}'") ? nil : "src/helpers/whatsNew.ts has none (a feature release gets one; a bug-fix release doesn't)"
    end
  end
  check.call("Free disk space", warn: true) do
    free = `df -Pk #{ROOT.shellescape}`.lines.last.split[3].to_i / 1024 / 1024
    free < MIN_FREE_GB ? "#{free} GB free; the four clean builds need about #{MIN_FREE_GB} GB" : nil
  end
  if electron
    check.call("Electron update signing key") do
      key = options[:key] || ENV["LEARNX_UPDATE_SIGNING_KEY"]
      next(File.exist?(File.expand_path(key.to_s)) ? nil : "no key file at #{key}") unless key.to_s.empty?

      ref = ENV["LEARNX_UPDATE_SIGNING_KEY_REF"].to_s
      next "no LEARNX_UPDATE_SIGNING_KEY_REF (or LEARNX_UPDATE_SIGNING_KEY) in fastlane/.env" if ref.empty?
      next "the 1Password CLI (op) isn't installed" unless system("command -v op > /dev/null")

      UI.important("1Password asks to approve reading the update signing key; approve it within a minute.")
      out, err, status = Open3.capture3("op", "read", ref)
      next "op read failed: #{err.strip} (turn on the 1Password app's CLI integration and approve the prompt)" unless status.success?

      out.include?("PRIVATE KEY") ? nil : "#{ref} isn't a PEM private key"
    end
    check.call("Electron update E2E passed on HEAD") do
      problem = electron_update_e2e_problem(sha)
      problem && "#{problem}: run `bundle exec fastlane electron update_e2e`"
    end
  end

  UI.header("Preflight v#{app_version} (#{build_number}) at #{sha[0, 8]}")
  results.each do |name, problem, warn|
    if problem.nil?
      UI.success("✓ #{name}")
    elsif warn
      UI.important("! #{name}: #{problem}")
    else
      UI.error("✗ #{name}: #{problem}")
    end
  end
  failed = results.count { |_, problem, warn| problem && !warn }
  UI.user_error!("Preflight: #{failed} check#{failed == 1 ? '' : 's'} failed") if failed.positive?
  UI.success("Ready to release v#{app_version} (#{build_number})")
end

# ---------------------------------------------------------------------------
# Lanes

desc "Set the app version everywhere and bump the build number."
desc "A new version moves the build number to the next multiple of 10; the same version adds 1 (a rebuild)."
desc "Either way it starts above the highest build App Store Connect and Google Play already have (uploads between releases take numbers too); remote:false skips that check."
desc "build: sets the build number itself, which must be above the current one."
desc "Usage: bundle exec fastlane bump version:18.1.0 build:<number> [remote:false]   (no version: rebuild of the current one; no build: the rule above)"
lane :bump do |options|
  current = app_version
  build = build_number
  version = (options[:version] || current).to_s.delete_prefix("v")
  UI.user_error!("Invalid version '#{version}': expected x.y.z") unless version.match?(/\A\d+\.\d+\.\d+\z/)
  verify_versions!

  new_build = Release.next_build(current, version, build)
  if options[:build]
    UI.user_error!("Invalid build '#{options[:build]}': expected a whole number") unless options[:build].to_s.match?(/\A\d+\z/)
    new_build = options[:build].to_i
    UI.user_error!("Build #{new_build} must be above the current build #{build}") unless new_build > build
  elsif !Release.off?(options[:remote])
    uploaded, errors = uploaded_builds
    errors.each { |error| UI.important("Couldn't check the uploaded builds of #{error}") }
    highest = uploaded.values.max
    new_build = Release.next_build(current, version, build, highest)
    if highest && highest >= Release.next_build(current, version, build)
      UI.important("Uploaded builds go up to #{highest} (#{uploaded.map { |name, b| "#{name} #{b}" }.join(', ')}), so the next is #{new_build}")
    end
  end
  paths = { package_json: PACKAGE_JSON, pbxproj: PBXPROJ, gradle: GRADLE }
  texts = Release.bump_texts(paths.transform_values { |path| File.read(path) }, from: [current, build], to: [version, new_build])
  paths.each { |key, path| File.write(path, texts[key]) }
  new_code = Release.android_version_code(new_build)

  UI.success("#{current} (#{build}) -> #{version} (#{new_build}, Android #{new_code})")
end

desc "Write the release notes with Claude Code (`claude -p` and the release-notes skill) for review."
desc "Saves build/release/v<version>/release-notes.md, which the release lanes use when no notes: is given."
desc "Without Claude Code (or with claude:false), writes a draft with the commit list and TODOs to fill in."
desc "Usage: bundle exec fastlane notes [claude:false]   (run `bump` first, so the version is the new one)"
lane :notes do |options|
  path = write_notes(use_claude: use_claude?(options))
  print_notes(path)
  UI.important("Review and edit #{path}, then run a release lane; it picks the file up without notes:.")
end

desc "Check everything a release needs before building: a clean, pushed commit with green CI, versions, a build number above every upload,"
desc "the App Store Connect and Play keys, Android signing, .env, the notes, and for Windows and Linux the signing key (1Password asks to approve) and the update E2E run."
desc "Usage: bundle exec fastlane preflight [notes:<file>|none] [electron:false]"
lane :preflight do |options|
  preflight(options)
end

desc "Build iOS, Mac, Android and (unless electron:false) Windows and Linux, uploading nothing. A failed Windows or Linux build doesn't undo the others."
desc "Usage: bundle exec fastlane build [electron:false] [platforms:win,linux]"
lane :build do |options|
  build_apple("ios")
  build_apple("macos")
  build_android
  build_electron(options) unless Release.off?(options[:electron])
end

desc "Upload everything to App Store Connect (not submitted for review), Google Play (a draft on track:) and a draft GitHub release."
desc "Uses this commit's builds from `build`, building only what's missing or stale (rebuild:true builds everything). Builds everything before uploading anything."
desc "store_notes:false keeps the stores' text and still puts the notes on the GitHub release; notes:none uploads no text."
desc "electron:true also builds (if needed) and signs the Windows and Linux app (from:, platforms: and key: as in `electron build`) and puts it on the GitHub release."
desc "Usage: bundle exec fastlane release [notes:<file>|none] [store_notes:false] [track:production] [rebuild:true] [electron:true [from:<dirs>]]"
lane :release do |options|
  ensure_git_status_clean
  notes = notes_for_release(options)
  %w[ios macos android].each { |platform| built_or_build(platform, options) }
  if options[:electron]
    built_or_build("electron", options)
    platforms = built_electron_platforms(options)
    sign_electron(options) unless electron_signed?(platforms)
  end
  upload_apple("ios", apple_package_path("ios"), store_text(notes, :ios, options))
  upload_apple("macos", apple_package_path("macos"), store_text(notes, :mac, options))
  upload_android(store_text(notes, :play, options), options[:track] || "production")
  publish_github(notes, electron_platforms: platforms)
end

desc "Decode the JS frames of a Crashlytics report with the source map of the bundle that crashed (scripts/release/symbolicate.mjs)."
desc "bundle: the report's js_bundle key (an update id, or embedded); a built-in bundle needs the report's version and build"
desc "(Android: its version code). Store maps come from build/release, or the version's GitHub release; update maps from build/ota/updates."
desc "Usage: bundle exec fastlane symbolicate platform:ios|macos|android stack:/path/to/stack.txt [bundle:<js_bundle>] [version:19.0.0 build:190] [map:/path/to/file.map]"
lane :symbolicate do |options|
  UI.user_error!("stack: is required, a file with the report's stack") unless options[:stack]
  args = %i[platform bundle version build map].flat_map do |key|
    options[key] ? ["--#{key}", options[key].to_s] : []
  end
  # Its output is the decoded stack, so it goes to the terminal as is.
  ok = system("node", File.join(ROOT, "scripts/release/symbolicate.mjs"), *args, File.expand_path(options[:stack].to_s))
  UI.user_error!("Symbolicating failed") unless ok
end

desc "Create a draft GitHub release with this commit's APKs, latest.json and source maps from `android build` (no rebuild)."
desc "Usage: bundle exec fastlane github_release [notes:<file>|none]"
lane :github_release do |options|
  ensure_git_status_clean
  publish_github(notes_for_release(options))
end

platform :ios do
  desc "Archive and export the App Store build, its dSYMs and source map to build/release/<version>/, and upload the dSYMs to Crashlytics."
  lane :build do
    build_apple("ios")
  end

  desc "Upload the dSYMs of this version's iOS build (build/release/<version>/ios/) to Crashlytics again, e.g. after a failed upload."
  lane :symbols do
    upload_built_dsyms("ios")
  end

  desc "Upload this commit's `ios build` to App Store Connect (not submitted for review), without rebuilding."
  desc "Usage: bundle exec fastlane ios upload [notes:<file>|none] [store_notes:false]"
  lane :upload do |options|
    ensure_git_status_clean
    notes = notes_for_release(options)
    verify_built!("ios")
    upload_apple("ios", apple_package_path("ios"), store_text(notes, :ios, options))
  end

  desc "Build (unless this commit's build is there; rebuild:true always) and upload to App Store Connect (not submitted for review)."
  desc "Usage: bundle exec fastlane ios release [notes:<file>|none] [store_notes:false] [rebuild:true]"
  lane :release do |options|
    ensure_git_status_clean
    notes = notes_for_release(options)
    built_or_build("ios", options)
    upload_apple("ios", apple_package_path("ios"), store_text(notes, :ios, options))
  end

  desc "Set a processed build's TestFlight What to Test to the App Store notes (no upload, nothing sent to testers)."
  desc "Usage: bundle exec fastlane ios testflight_notes [build:<number>] [notes:/path/to/notes.md | what_to_test:<text>]   (build: this version's build number)"
  lane :testflight_notes do |options|
    distribute_testflight("ios", options[:build] || build_number, what_to_test(options, :ios))
  end

  desc "Submit a processed build for Beta App Review and add it to the external TestFlight groups; testers get it once Apple approves it."
  desc "Sets What to Test first, as testflight_notes does. Asks before submitting when run in a terminal."
  desc "Usage: bundle exec fastlane ios beta_review [build:<number>] [notes:/path/to/notes.md | what_to_test:<text>] [groups:<name,...>]"
  lane :beta_review do |options|
    submit_for_beta_review("ios", :ios, options)
  end
end

