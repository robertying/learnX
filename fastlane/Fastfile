platform :electron do
  desc "Put the Windows and Linux installers, latest*.yml and blockmaps into build/release/v<version>/electron/, checked for this version."
  desc "Packages them here, or copies them from folders built on a Windows PC or Linux."
  desc "Usage: bundle exec fastlane electron build [from:/path/win,/path/linux] [platforms:win,linux]"
  lane :build do |options|
    build_electron(options)
  end

  desc "Sign the update files there (scripts/release/sign-electron-update.mjs), with the key from 1Password."
  desc "Usage: bundle exec fastlane electron sign [key:/path/to/key.pem]   (or LEARNX_UPDATE_SIGNING_KEY_REF in fastlane/.env)"
  lane :sign do |options|
    sign_electron(options)
  end

  desc "Run a real update (the Electron workflow's Update E2E jobs, Windows and Linux) on main, which must be this commit, and wait for it (wait:false doesn't)."
  desc "Usage: bundle exec fastlane electron update_e2e [wait:false]"
  lane :update_e2e do |options|
    run_electron_update_e2e(options)
  end

  desc "Add this commit's signed Windows and Linux files to the draft v<version> GitHub release (made by `release` or `github_release`), without rebuilding."
  desc "Usage: bundle exec fastlane electron upload [platforms:win,linux]"
  lane :upload do |options|
    ensure_git_status_clean
    upload_electron(built_electron_platforms(options))
  end

  desc "Build (unless this commit's build is there; rebuild:true always), sign if unsigned, and add the files to the draft v<version> GitHub release."
  desc "Usage: bundle exec fastlane electron release [from:<dirs>] [platforms:win,linux] [key:/path/to/key.pem] [rebuild:true]"
  lane :release do |options|
    ensure_git_status_clean
    built_or_build("electron", options)
    platforms = built_electron_platforms(options)
    sign_electron(options) unless electron_signed?(platforms)
    upload_electron(platforms)
  end
end
