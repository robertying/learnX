# Copy to .env (git-ignored). babel/inline-env.js inlines the keys below into
# helpers/env.ts at build time; other keys are left out. Restart Metro after a
# change (it re-transforms when .env changes) and rebuild release builds.

# Mock accounts: typing these on the login screen loads src/data/mock.ts
# instead of the real server. Pick any non-empty values; they aren't real
# credentials.
DUMMY_USERNAME=
DUMMY_PASSWORD=
# Same mock data, but the login is saved across relaunches.
DUMMY_PERSIST_USERNAME=
DUMMY_PERSIST_PASSWORD=

# courseX (Course Information Sharing) API token. Leave empty to build
# without the feature working. Shipped masked, not as plain text.
COURSEX_REFRESH_TOKEN=

# Live test login (optional): any LIVE_* key is inlined into debug builds only,
# never release builds. The fastlane build lanes fail if a release bundle
# contains one of these values.
LIVE_USERNAME=
LIVE_PASSWORD=
LIVE_FINGERPRINT=
