# Copy to .env (git-ignored). helpers/env.ts inlines it into the JS bundle at
# build time, so rebuild or restart Metro with --reset-cache after a change.

# Mock accounts: typing these on the login screen loads src/data/mock.ts
# instead of the real server. Pick any non-empty values; they aren't real
# credentials.
DUMMY_USERNAME=
DUMMY_PASSWORD=
# Same mock data, but the login is saved across relaunches.
DUMMY_PERSIST_USERNAME=
DUMMY_PERSIST_PASSWORD=

# courseX (Course Information Sharing) API token. Leave empty to build
# without the feature working.
COURSEX_REFRESH_TOKEN=
