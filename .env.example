# Copy to .env (git-ignored). babel/inline-env.js inlines the keys below into
# helpers/env.ts at build time; other keys are left out. Restart Metro after a
# change (it re-transforms when .env changes) and rebuild release builds.

# Mock account: typing these on the login screen loads src/data/mock.ts
# from an emulated server instead of the real one, and the login is saved
# across relaunches. Pick any non-empty values; they aren't real credentials.
DUMMY_USERNAME=
DUMMY_PASSWORD=

# Live test login (optional): any LIVE_* key is inlined into debug builds only,
# never release builds. The fastlane build lanes fail if a release bundle
# contains one of these values.
LIVE_USERNAME=
LIVE_PASSWORD=
LIVE_FINGERPRINT=

# Over-the-air updates (AGENTS.md, "Over-the-air updates"): the update
# server's manifest URL and the Expo project id it serves. Release builds and
# `eoas publish` read them; a build without OTA_UPDATE_URL has updates off,
# and the release lanes refuse to build without it.
OTA_UPDATE_URL=
EXPO_PROJECT_ID=
