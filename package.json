    "react-native-share": "12.3.1",
    "react-native-tab-view": "4.3.5",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "semver": "7.8.6",
    "test-renderer": "1.3.1",
    "typescript": "7.0.2",
    "zustand": "5.1.0"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ],
      "android": {
        "buildFromSource": [
          "expo-calendar",
          "expo-document-picker",
          "expo-ui"
        ]
      }
    }
  }
}
