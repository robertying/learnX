    "@expo/ui": "58.0.29",
    "@fluentui/react-components": "9.75.2",
    "@fluentui/react-icons": "2.0.346",
    "@preeternal/react-native-cookie-manager": "7.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "21.0.0",
    "@react-native-community/cli-platform-android": "21.0.0",
    "@react-native-community/cli-platform-ios": "21.0.0",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@robertying/thu-learn-lib": "9.1.2",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/query-persist-client-core": "5.108.0",
