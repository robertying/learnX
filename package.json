{
  "name": "learnX",
  "version": "19.0.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "scripts": {
    "pod:update": "cd ios && bundle exec pod install && bundle exec pod update",
    "start": "react-native start --client-logs",
    "ios": "react-native run-ios",
    "android": "react-native run-android --mode githubDebug",
    "electron": "node electron/dev.ts",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:shell": "git ls-files -z '*.sh' | xargs -0 shellcheck",
    "typecheck": "tsc && tsc -p scripts && tsc -p electron",
    "test": "jest",
    "test:fastlane": "ruby -e 'Dir[\"fastlane/test/*_test.rb\"].each { |file| require \"./#{file}\" }'",
    "ota:check": "node scripts/checks/check-ota-runtime.mjs",
    "check": "pnpm typecheck && pnpm lint --deny-warnings && pnpm format --check && pnpm ota:check && pnpm test --coverage && pnpm test:fastlane && pnpm lint:shell",
    "e2e:ios": "scripts/e2e/e2e.sh ios",
    "e2e:android": "scripts/e2e/e2e.sh android",
    "e2e:electron": "playwright test -c electron/playwright.config.ts",
    "e2e:electron:update": "node electron/updateE2E.ts",
    "e2e:mac": "scripts/e2e/e2e-mac.sh",
    "e2e:devices": "scripts/e2e/e2e-devices.sh",
    "bump": "scripts/release/bump.sh",
    "store:screenshots": "scripts/e2e/store-screenshots.sh",
    "electron:package": "node electron/package.ts",
    "electron:clean": "node electron/clean.ts"
  },
  "dependencies": {
    "@babel/core": "7.29.13",
    "@babel/runtime": "7.29.13",
    "@bottom-tabs/react-navigation": "1.5.0",
