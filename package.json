    "expo-intent-launcher": "58.0.3",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.9",
    "expo-secure-store": "58.0.3",
    "expo-sqlite": "58.0.18",
    "expo-symbols": "58.0.5",
    "expo-task-manager": "58.0.14",
    "expo-updates": "58.0.22",
    "expo-widgets": "58.0.29",
    "fuse.js": "7.5.0",
    "he": "2.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "katex": "0.19.1",
    "mime": "4.1.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "react-dom": "19.3.1",
