    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-preval": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "58.0.26",
    "dayjs": "1.11.23",
    "dotenv": "18.0.10",
    "expo": "58.0.26",
    "expo-application": "58.1.2",
