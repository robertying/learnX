@@ -388,8 +388,33 @@
   _backedTextInputView.inputAccessoryView = nil;
   _hasInputAccessoryView = false;
   [_backedTextInputView resignFirstResponder];
+
+  // UIKit's AutoFill keeps the text fields it has grouped as username/password,
+  // so a recycled credential field would carry that role into an unrelated input.
+  if ([self _isCredentialTextInput]) {
+    [self _replaceBackedTextInputView];
+  }
 }
 
+- (BOOL)_isCredentialTextInput
+{
+  UITextContentType textContentType = _backedTextInputView.textContentType;
+  return _backedTextInputView.secureTextEntry || [textContentType isEqualToString:UITextContentTypeUsername] ||
+      [textContentType isEqualToString:UITextContentTypePassword] ||
+      [textContentType isEqualToString:UITextContentTypeNewPassword];
+}
+
+- (void)_replaceBackedTextInputView
+{
+  UIView<RCTBackedTextInputViewProtocol> *oldTextInputView = _backedTextInputView;
+  [self _setMultiline:[oldTextInputView isKindOfClass:[RCTUITextView class]]];
+  // Props diffed in updateProps but not copied by RCTCopyBackedTextInput.
+  _backedTextInputView.returnKeyType = oldTextInputView.returnKeyType;
+  _backedTextInputView.tintColor = oldTextInputView.tintColor;
+  _backedTextInputView.inputView = oldTextInputView.inputView;
+  _backedTextInputView.dataDetectorTypes = oldTextInputView.dataDetectorTypes;
+}
