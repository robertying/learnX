+package com.github.barteksc.pdfviewer;
+
+import android.os.Message;
+
+/**
+ * Keeps PDFView.recycle() from closing the document under an in-flight render.
+ *
+ * recycle() (also called from onDetachedFromWindow()) disposes the document on the main
+ * thread, but RenderingHandler may be rendering a page on the "PDF renderer" thread at that
+ * moment; stop() and removeMessages() only drop queued work. The render then hands the closed
+ * document to Pdfium and crashes. This class lives in the viewer's package to reach its
+ * package-private state, which the prebuilt AndroidPdfViewer AAR does not expose.
+ */
+public final class RecycleSafeRendering {
+
+    private RecycleSafeRendering() {
+    }
+
+    /**
+     * Replaces the view's rendering handler with one that drops tasks once the view is
+     * recycled. Call from the OnLoadCompleteListener, before any page is queued.
+     */
+    public static void install(PDFView view) {
+        RenderingHandler handler = view.renderingHandler;
+        if (handler == null || handler instanceof GuardedRenderingHandler) {
+            return;
+        }
+        handler.stop();
+        handler.removeMessages(RenderingHandler.MSG_RENDER_TASK);
+        GuardedRenderingHandler guarded = new GuardedRenderingHandler(handler, view);
+        guarded.start();
+        view.renderingHandler = guarded;
+    }
+
+    /**
+     * Runs PDFView.recycle() (passed as {@code superRecycle}) but disposes the document on the
+     * renderer thread, after any render already running there has finished.
+     */
+    public static void recycle(PDFView view, Runnable superRecycle) {
+        RenderingHandler handler = view.renderingHandler;
+        PdfFile pdfFile = view.pdfFile;
+        if (handler != null) {
+            handler.stop();
+            handler.removeMessages(RenderingHandler.MSG_RENDER_TASK);
+        }
+        // Hide the document from super.recycle(), which would dispose it right away.
+        view.pdfFile = null;
+        superRecycle.run();
+        // onDetachedFromWindow() quits the renderer thread with quitSafely(), which still runs
+        // this; post() only fails if the thread is already gone, and then nothing is rendering.
+        if (pdfFile != null && (handler == null || !handler.post(pdfFile::dispose))) {
+            pdfFile.dispose();
+        }
+    }
+
+    private static final class GuardedRenderingHandler extends RenderingHandler {
+
+        // Written on the main thread by start()/stop(), read on the renderer thread.
+        private volatile boolean running = false;
+
+        GuardedRenderingHandler(RenderingHandler handler, PDFView view) {
+            super(handler.getLooper(), view);
+        }
+
+        @Override
+        void start() {
+            running = true;
+            super.start();
+        }
+
+        @Override
+        void stop() {
+            running = false;
+            super.stop();
+        }
+
+        @Override
+        public void handleMessage(Message message) {
+            if (!running) {
+                return;
+            }
+            try {
+                super.handleMessage(message);
+            } catch (NullPointerException | IllegalStateException e) {
+                // A task picked up just as the view was recycled finds the document gone.
+                if (running) {
+                    throw e;
+                }
+            }
+        }
+    }
+}
