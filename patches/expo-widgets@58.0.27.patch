diff --git a/ios/Widgets/ViewThatFitsView.swift b/ios/Widgets/ViewThatFitsView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3c9a494368066699ba7dbaf1c77dc58f483b676d
--- /dev/null
+++ b/ios/Widgets/ViewThatFitsView.swift
@@ -0,0 +1,32 @@
+import SwiftUI
+import ExpoModulesCore
+import ExpoUI
+
+// learnX: SwiftUI's ViewThatFits for widget layouts, which @expo/ui doesn't
+// have. A layout makes the node itself: { type: 'ViewThatFitsView', props }.
+final class ViewThatFitsViewProps: UIBaseViewProps {
+  // "horizontal", "vertical", or both when unset.
+  @Field var axes: String?
+}
+
+struct ViewThatFitsView: ExpoSwiftUI.View {
+  @ObservedObject var props: ViewThatFitsViewProps
+
+  init(props: ViewThatFitsViewProps) {
+    self.props = props
+  }
+
+  private var axes: Axis.Set {
+    switch props.axes {
+    case "horizontal": return .horizontal
+    case "vertical": return .vertical
+    default: return [.horizontal, .vertical]
+    }
+  }
+
+  var body: some View {
+    ViewThatFits(in: axes) {
+      Children()
+    }
+  }
+}
