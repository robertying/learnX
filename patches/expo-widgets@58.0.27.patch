diff --git a/ios/Widgets/CountdownView.swift b/ios/Widgets/CountdownView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..2ecc571ae4cfebe3c426a2e7b585514b912ba37d
--- /dev/null
+++ b/ios/Widgets/CountdownView.swift
@@ -0,0 +1,51 @@
+import SwiftUI
+import ExpoModulesCore
+import ExpoUI
+
+// learnX: the time left until (or since) a date, kept live by the system
+// like Text(date, style: .relative), but in days, hours and minutes, at most
+// two of them ("42 minutes", "2 days, 20 hours") or as many as
+// `maxFieldCount`, without the seconds the relative style counts under an
+// hour. A layout makes the node itself:
+// { type: 'CountdownView', props: { date, maxFieldCount, modifiers } }.
+final class CountdownViewProps: UIBaseViewProps {
+  @Field var date: Date?
+  @Field var maxFieldCount: Int?
+}
+
+struct CountdownView: ExpoSwiftUI.View {
+  @ObservedObject var props: CountdownViewProps
+  @Environment(\.locale) private var locale
+
+  init(props: CountdownViewProps) {
+    self.props = props
+  }
+
+  var body: some View {
+    if let date = props.date {
+      if #available(iOS 18.0, *) {
+        let format = SystemFormatStyle.DateOffset.offset(
+          to: date,
+          allowedFields: [.day, .hour, .minute],
+          maxFieldCount: props.maxFieldCount ?? 2,
+          sign: .never
+        ).locale(locale)
+        // A live Text takes all the width it's offered, and fixedSize blanks
+        // the widget, so it takes the width of its value at render time and
+        // the rest of its row (a course name) gives way to it. Both draw
+        // equal-width digits, so the live value fills the width it was given
+        // (proportional digits left a gap after a narrow "1").
+        Text(format.format(Date()))
+          .monospacedDigit()
+          .hidden()
+          .overlay(alignment: .leading) {
+            Text(.currentDate, format: format)
+              .monospacedDigit()
+              .minimumScaleFactor(0.8)
+          }
+      } else {
+        Text(date, style: .relative)
+      }
+    }
+  }
+}
