diff --git a/Libraries/Network/FormData.js b/Libraries/Network/FormData.js
index 3e7b02e..dd8e9c6 100644
--- a/Libraries/Network/FormData.js
+++ b/Libraries/Network/FormData.js
@@ -91,8 +91,19 @@ class FormData {
       // content type (cf. web Blob interface.)
       if (typeof value === 'object' && !Array.isArray(value) && value) {
         if (typeof value.name === 'string') {
+          // Web Learning reads the UTF-8 name in `filename` (a percent-encoded
+          // one shows as is). Like browsers (HTML spec), escape only what would
+          // end the quoted string or the header; `filename*` has RFC 5987 form.
+          const quotedName = value.name.replace(
+            /[\r\n"]/g,
+            char => ({'\r': '%0D', '\n': '%0A', '"': '%22'})[char],
+          );
+          const extendedName = encodeURIComponent(value.name).replace(
+            /['()*]/g,
+            char => `%${char.charCodeAt(0).toString(16).toUpperCase()}`,
+          );
           headers['content-disposition'] +=
-            `; filename="${encodeFilename(value.name)}"`;
+            `; filename="${quotedName}"; filename*=utf-8''${extendedName}`;
         }
         if (typeof value.type === 'string') {
           headers['content-type'] = value.type;
diff --git a/React/Fabric/Mounting/ComponentViews/TextInput/RCTTextInputComponentView.mm b/React/Fabric/Mounting/ComponentViews/TextInput/RCTTextInputComponentView.mm
index 8f55121..593f570 100644
--- a/React/Fabric/Mounting/ComponentViews/TextInput/RCTTextInputComponentView.mm
+++ b/React/Fabric/Mounting/ComponentViews/TextInput/RCTTextInputComponentView.mm
@@ -397,6 +397,31 @@ static NSSet<NSNumber *> *returnKeyTypesSet;
   _backedTextInputView.inputAccessoryView = nil;
   _hasInputAccessoryView = false;
   [_backedTextInputView resignFirstResponder];
+
+  // UIKit's AutoFill keeps the text fields it has grouped as username/password,
+  // so a recycled credential field would carry that role into an unrelated input.
+  if ([self _isCredentialTextInput]) {
+    [self _replaceBackedTextInputView];
+  }
+}
+
+- (BOOL)_isCredentialTextInput
+{
+  UITextContentType textContentType = _backedTextInputView.textContentType;
+  return _backedTextInputView.secureTextEntry || [textContentType isEqualToString:UITextContentTypeUsername] ||
+      [textContentType isEqualToString:UITextContentTypePassword] ||
+      [textContentType isEqualToString:UITextContentTypeNewPassword];
+}
+
+- (void)_replaceBackedTextInputView
+{
+  UIView<RCTBackedTextInputViewProtocol> *oldTextInputView = _backedTextInputView;
+  [self _setMultiline:[oldTextInputView isKindOfClass:[RCTUITextView class]]];
+  // Props diffed in updateProps but not copied by RCTCopyBackedTextInput.
+  _backedTextInputView.returnKeyType = oldTextInputView.returnKeyType;
+  _backedTextInputView.tintColor = oldTextInputView.tintColor;
+  _backedTextInputView.inputView = oldTextInputView.inputView;
+  _backedTextInputView.dataDetectorTypes = oldTextInputView.dataDetectorTypes;
 }
 
 #pragma mark - RCTBackedTextInputDelegate
