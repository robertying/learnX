<?xml version="1.0" encoding="utf-8"?>
<!-- The Next Class widget in the widget picker (Android 12+, xml/up_next_info.xml): what
     src/widgets/UpNext.android.tsx draws, with sample classes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:text="@string/up_next_display_name"
        android:textColor="@color/md_theme_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_course"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_class_time"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="13sp" />

    <!-- A later class: the course, taking the width left, and when, at the end. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_preview_later_course"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/widget_preview_later_time"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
