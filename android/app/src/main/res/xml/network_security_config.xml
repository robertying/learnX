<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The E2E builds' over-the-air update server (scripts/e2e/ota-e2e-server.mjs)
         and APK mirror (scripts/e2e/updater-e2e-server.mjs), through adb reverse.
         Traffic to localhost never leaves the device. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
