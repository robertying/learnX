<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Deadline reminders at their exact time (Android 12+). Android 14 doesn't grant it by
         default; Settings › Notifications links to the system page that does. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/launcher_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/SplashTheme"
        tools:targetApi="tiramisu">

        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="expo.modules.notifications.default_notification_icon"
            android:resource="@drawable/notification_icon" />
        <meta-data
            android:name="expo.modules.notifications.default_notification_color"
            android:resource="@color/seed" />

        <!-- Whether updates are on, the URL, runtime version, headers and
             certificate come from android/app/build.gradle. -->
        <meta-data
            android:name="expo.modules.updates.ENABLED"
            android:value="${otaEnabled}" />
        <meta-data
            android:name="expo.modules.updates.EXPO_UPDATE_URL"
            android:value="@string/expo_updates_url" />
        <meta-data
            android:name="expo.modules.updates.EXPO_RUNTIME_VERSION"
            android:value="@string/expo_runtime_version" />
        <meta-data
            android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH"
            android:value="ALWAYS" />
        <meta-data
            android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS"
            android:value="0" />
        <meta-data
            android:name="expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY"
            android:value="@string/expo_updates_request_headers" />
        <meta-data
            android:name="expo.modules.updates.CODE_SIGNING_CERTIFICATE"
            android:value="@string/expo_updates_certificate" />
        <meta-data
            android:name="expo.modules.updates.CODE_SIGNING_METADATA"
            android:value="{&quot;keyid&quot;:&quot;main&quot;,&quot;alg&quot;:&quot;rsa-v1_5-sha256&quot;}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:documentLaunchMode="never"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="learnx" />
            </intent-filter>

            <!-- Files shared to learnX, read by modules/share. text/* is for text files; a share of
                 text alone is turned down in the app (only files can be attached). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- Image cropping (expo-image-picker allowsEditing) is unused. Remove the cropper
             activities so they can't be launched without their extras. Restore them if
             allowsEditing is ever used. -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <activity
            android:name="expo.modules.imagepicker.ExpoCropImageActivity"
            tools:node="remove" />

        <!-- Home screen widget from expo-widgets (src/widgets/Deadlines.android.tsx). -->
        <receiver
            android:name=".DeadlinesProvider"
            android:exported="true"
            android:label="@string/deadlines_display_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="expo.modules.widgets.ACTION_WIDGET_INTERACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deadlines_info" />
            <meta-data
                android:name="expo.modules.widgets.NAME"
                android:value="Deadlines" />
        </receiver>

        <!-- Home screen widget from expo-widgets (src/widgets/UpNext.android.tsx). -->
        <receiver
            android:name=".UpNextProvider"
            android:exported="true"
            android:label="@string/up_next_display_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="expo.modules.widgets.ACTION_WIDGET_INTERACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_next_info" />
            <meta-data
                android:name="expo.modules.widgets.NAME"
                android:value="UpNext" />
        </receiver>
    </application>

    <queries>
        <provider android:authorities="com.android.calendar" />
    </queries>
</manifest>
