            android:value="{&quot;keyid&quot;:&quot;main&quot;,&quot;alg&quot;:&quot;rsa-v1_5-sha256&quot;}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:documentLaunchMode="never"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="learnx" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- Image cropping (expo-image-picker allowsEditing) is unused. Remove the cropper
             activities so they can't be launched without their extras. Restore them if
             allowsEditing is ever used. -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            tools:node="remove" />
        <activity
            android:name="expo.modules.imagepicker.ExpoCropImageActivity"
            tools:node="remove" />
    </application>

    <queries>
        <provider android:authorities="com.android.calendar" />
    </queries>
</manifest>
