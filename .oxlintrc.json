{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "react", "jest"],
  "jsPlugins": ["./lint/plugin.mjs"],
  "categories": {
    "correctness": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2026": true
  },
  "globals": {
    "__DEV__": "writable",
    "__dirname": "readonly",
    "__fbBatchedBridgeConfig": "readonly",
    "AbortController": "readonly",
    "Blob": "writable",
    "alert": "readonly",
    "cancelAnimationFrame": "readonly",
    "cancelIdleCallback": "readonly",
    "clearImmediate": "writable",
    "clearInterval": "readonly",
    "clearTimeout": "readonly",
    "console": "readonly",
    "document": "readonly",
    "ErrorUtils": "readonly",
    "Event": "readonly",
    "EventTarget": "readonly",
    "exports": "readonly",
    "fetch": "readonly",
    "File": "writable",
    "FileReader": "readonly",
    "FormData": "readonly",
    "global": "readonly",
    "Headers": "readonly",
    "Map": "writable",
    "module": "readonly",
    "navigator": "readonly",
    "process": "readonly",
    "Promise": "writable",
    "requestAnimationFrame": "writable",
    "requestIdleCallback": "writable",
    "require": "readonly",
    "Set": "writable",
    "setImmediate": "writable",
    "setInterval": "readonly",
    "setTimeout": "readonly",
    "queueMicrotask": "writable",
    "URL": "readonly",
    "URLSearchParams": "readonly",
    "WebSocket": "writable",
    "window": "readonly",
    "XMLHttpRequest": "readonly"
  },
  "rules": {
    "no-regex-spaces": "warn",
    "eqeqeq": [
      "warn",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-alert": "warn",
    "no-div-regex": "warn",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-fallthrough": "warn",
    "no-implied-eval": "warn",
    "no-labels": "warn",
    "no-lone-blocks": "warn",
    "no-new": "warn",
    "no-new-func": "warn",
    "no-new-wrappers": "warn",
    "no-proto": "warn",
    "no-return-assign": "warn",
    "no-script-url": "warn",
    "no-self-compare": "warn",
    "no-sequences": "warn",
    "no-void": [
      "warn",
      {
        "allowAsStatement": true
      }
    ],
    "radix": "warn",
    "yoda": "warn",
    "no-label-var": "warn",
    "no-shadow": "warn",
    "no-undef": "warn",
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-array-constructor": "warn",
    "no-bitwise": "warn",
    "react/jsx-no-comment-textnodes": "warn",
    "react/no-unstable-nested-components": "warn",
    "react/self-closing-comp": "warn",
    "jest/no-identical-title": "warn",
    "react/rules-of-hooks": "warn",
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": ["react-native/**"],
            "message": "Import from the react-native package root instead of a deep path."
          }
        ]
      }
    ],
    "no-await-in-loop": "off",
    "react/jsx-no-constructed-context-values": "off"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "plugins": ["typescript"],
      "rules": {
        "no-undef": "off",
        "no-unused-vars": [
          "warn",
          {
            "varsIgnorePattern": "_"
          }
        ],
        "react/no-unstable-nested-components": [
          "warn",
          {
            "allowAsProps": true
          }
        ]
      }
    },
    {
      "files": [
        "**/*.{spec,test}.{js,ts,tsx}",
        "**/__{mocks,tests}__/**/*.{js,ts,tsx}"
      ],
      "env": {
        "jest": true
      },
      "plugins": ["typescript"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["src/**/*.{js,ts,tsx}"],
      "rules": {
        "learnx/no-han-outside-translations": "error"
      }
    },
    {
      "files": [
        "src/assets/translations/**",
        "src/**/__tests__/**",
        "src/**/*.{spec,test}.{js,ts,tsx}",
        "src/data/mock.ts"
      ],
      "rules": {
        "learnx/no-han-outside-translations": "off"
      }
    },
    {
      "files": ["src/helpers/preval/sso.js"],
      "env": {
        "browser": true
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.3.1"
    }
  },
  "options": {
    "reportUnusedDisableDirectives": "warn",
    "typeAware": true
  },
  "ignorePatterns": ["android/", "ios/"]
}
