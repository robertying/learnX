{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "react", "jest"],
  "jsPlugins": ["./lint/plugin.mjs"],
  "categories": {
    "correctness": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "node": true
  },
  "rules": {
    "no-regex-spaces": "warn",
    "eqeqeq": [
      "warn",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-alert": "warn",
    "no-div-regex": "warn",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-fallthrough": "warn",
    "no-implied-eval": "warn",
    "no-labels": "warn",
    "no-lone-blocks": "warn",
    "no-new": "warn",
    "no-new-func": "warn",
    "no-new-wrappers": "warn",
    "no-proto": "warn",
    "no-return-assign": "warn",
    "no-script-url": "warn",
    "no-self-compare": "warn",
    "no-sequences": "warn",
    "no-void": [
      "warn",
      {
        "allowAsStatement": true
      }
    ],
    "radix": "warn",
    "yoda": "warn",
    "no-label-var": "warn",
    "no-shadow": "warn",
    "no-undef": "warn",
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-array-constructor": "warn",
    "no-bitwise": "warn",
    "react/jsx-no-comment-textnodes": "warn",
    "react/no-unstable-nested-components": "warn",
    "react/self-closing-comp": "warn",
    "jest/no-identical-title": "warn",
    "react/rules-of-hooks": "warn",
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": ["react-native/**"],
            "message": "Import from the react-native package root instead of a deep path."
          }
        ]
      }
    ],
    "no-await-in-loop": "off",
    "react/jsx-no-constructed-context-values": "off"
  },
  "overrides": [
    {
      "files": [".maestro/**/*.js"],
      // Maestro's runScript globals, and the flow's env values (upgrade/).
      "globals": {
        "maestro": "readonly",
        "output": "writable",
        "PHASE": "readonly",
        "USERNAME": "readonly"
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "plugins": ["typescript"],
      "rules": {
        "no-undef": "off",
        "no-unused-vars": [
          "warn",
          {
            "varsIgnorePattern": "_"
          }
        ],
        "react/no-unstable-nested-components": [
          "warn",
          {
            "allowAsProps": true
          }
        ]
      }
    },
    {
      "files": [
        "**/*.{spec,test}.{js,ts,tsx}",
        "**/__{mocks,tests}__/**/*.{js,ts,tsx}"
      ],
      "env": {
        "jest": true
      },
      "plugins": ["typescript"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["src/**/*.{js,ts,tsx}"],
      "rules": {
        "learnx/no-han-outside-translations": "error"
      }
    },
    {
      "files": [
        "src/assets/translations/**",
        "src/**/__tests__/**",
        "src/**/*.{spec,test}.{js,ts,tsx}",
        "src/data/mock.ts",
        "src/data/mockEnglish.ts"
      ],
      "rules": {
        "learnx/no-han-outside-translations": "off"
      }
    },
    {
      // Scripts the app runs in its web views
      "files": [
        "src/helpers/preval/sso.js",
        "src/helpers/preval/ssoAlerts.js",
        "src/helpers/preval/darkMode.js"
      ],
      "env": {
        "browser": true
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.3.1"
    }
  },
  "options": {
    "reportUnusedDisableDirectives": "warn",
    "typeAware": true
  },
  "ignorePatterns": ["android/", "ios/"]
}
