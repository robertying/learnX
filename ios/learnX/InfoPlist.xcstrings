    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "learnX syncs your course schedule and assignments to Calendar. It reads your list of calendars to choose where to add events, and can delete the calendars it created."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "learnX 会将课表和作业同步到日历。它会读取日历列表以选择写入位置，并可删除它创建的日历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "learnX 会将课表和作业同步到日历。它会读取日历列表以选择写入位置，并可删除它创建的日历。"
          }
        }
      }
    },
