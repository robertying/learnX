require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

platform :ios, '16.6'
prepare_react_native_project!

# Build React Native core and its third-party deps (folly, etc.) from source:
# patches/react-native+*.patch changes native code (RCTTextInputComponentView.mm)
# that a prebuilt core would leave out.
ENV['RCT_USE_RN_DEP'] = '0'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

# Compile react-native-screens' experimental components (native split view).
ENV['RNS_GAMMA_ENABLED'] = '1'

ENV['USE_FRAMEWORKS'] = 'static'
use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym

config_command = [
  'npx',
  'expo-modules-autolinking',
  'react-native-config',
  '--json',
  '--platform',
  'ios'
]

target 'learnX' do
  use_expo_modules!

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    hermes_enabled: true
  )

  pod 'FirebaseAnalytics/WithoutAdIdSupport'
  pod 'FirebaseCrashlytics'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => true
    )

    # pod install can drop hermes-engine/.last_build_configuration while leaving a
    # Release binary from an earlier archive in place, so Debug builds fail to link.
    # An unknown value makes the next build always extract the matching tarball.
    hermes_dir = File.join(installer.sandbox.root.to_s, 'hermes-engine')
    File.write(File.join(hermes_dir, '.last_build_configuration'), 'Unknown') if Dir.exist?(hermes_dir)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # The extensions link the same pods as the app, and some of them use
        # app-only API (UIApplication.shared) in code the extensions never run.
        config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
        # React Native headers aren't modular; static frameworks include them anyway.
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # Pods build for the project's deployment target, not their own older ones.
        config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
        # Settings Xcode no longer wants on framework targets.
        config.build_settings.delete 'EMBEDDED_CONTENT_CONTAINS_SWIFT'
        config.build_settings.delete 'ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'
      end
    end

    # Xcode's recommended project settings, so it stops offering to update the
    # Pods project; pods are signed with the app, so they need no identity.
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS'] = 'YES'
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings.delete 'STRIP_INSTALLED_PRODUCT'
      config.build_settings.delete 'STRIP_STYLE'
      config.build_settings.delete 'STRIP_SWIFT_SYMBOLS'
    end
  end
end

target 'ShareExtension' do
  use_react_native!(
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    hermes_enabled: true
  )

  pod 'RNShareMenu', :path => '../node_modules/react-native-share-menu'
end

# Home screen widgets (expo-widgets). The widget extension only links Expo,
# ExpoUI and ExpoWidgets; see `use_expo_modules_widgets!`. This mirrors what
# the expo-widgets config plugin adds to a prebuild project.
require File.join(File.dirname(`node --print "require.resolve('expo-widgets/package.json')"`), "scripts/autolinking")

target 'ExpoWidgetsTarget' do
  use_expo_modules_widgets!

  config = use_expo_native_module!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    hermes_enabled: true
  )
end
