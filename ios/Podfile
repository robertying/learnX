require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

platform :ios, '17.6'
prepare_react_native_project!

# Build React Native core and its third-party deps (folly, etc.) from source:
# patches/react-native@*.patch changes native code (RCTTextInputComponentView.mm)
# that a prebuilt core would leave out.
ENV['RCT_USE_RN_DEP'] = '0'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

# Compile react-native-screens' experimental components (native split view).
ENV['RNS_GAMMA_ENABLED'] = '1'

ENV['USE_FRAMEWORKS'] = 'static'
use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym

config_command = [
  'npx',
  'expo-modules-autolinking',
  'react-native-config',
  '--json',
  '--platform',
  'ios'
]

target 'learnX' do
  # The local modules' unit tests (modules/*/ios/Tests) are CocoaPods test specs;
  # scripts/test-ios.sh runs them. use_expo_modules! leaves pods added before it
  # as they are.
  Dir.glob('../modules/*/ios/*.podspec', base: Pod::Config.instance.installation_root).sort.each do |podspec|
    pod File.basename(podspec, '.podspec'), :path => File.dirname(podspec), :testspecs => ['Tests']
  end

  use_expo_modules!

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    hermes_enabled: true
  )

  pod 'FirebaseAnalytics/WithoutAdIdSupport'
  pod 'FirebaseCrashlytics'

  # The app's own tests (learnXTests), hosted in the app.
  target 'learnXTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => true
    )

    # pod install can drop hermes-engine/.last_build_configuration while leaving a
    # Release binary from an earlier archive in place, so Debug builds fail to link.
    # An unknown value makes the next build always extract the matching tarball.
    hermes_dir = File.join(installer.sandbox.root.to_s, 'hermes-engine')
    File.write(File.join(hermes_dir, '.last_build_configuration'), 'Unknown') if Dir.exist?(hermes_dir)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # The widget extension links the same pods as the app, and some of them use
        # app-only API (UIApplication.shared) in code the extension never runs.
        config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
        # React Native headers aren't modular; static frameworks include them anyway.
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # Pods build for the project's deployment target, not their own older ones.
        config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
        # Settings Xcode no longer wants on framework targets.
        config.build_settings.delete 'EMBEDDED_CONTENT_CONTAINS_SWIFT'
        config.build_settings.delete 'ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'
        # The Pods-* targets only build an umbrella module, which verifies cleanly.
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'YES' if target.name.start_with?('Pods-')
      end
    end

    # The apps CocoaPods makes to host the modules' tests (AppHost-*) don't adopt
    # scenes, and iOS 27 stops such an app at launch.
    Dir.glob(File.join(installer.sandbox.root.to_s, 'AppHost-*', '*-Info.plist')).each do |path|
      info = Xcodeproj::Plist.read_from_path(path)
      info['UIApplicationSceneManifest'] = {
        'UIApplicationSupportsMultipleScenes' => false,
        'UISceneConfigurations' => {
          'UIWindowSceneSessionRoleApplication' => [{ 'UISceneConfigurationName' => 'Default Configuration' }]
        }
      }
      Xcodeproj::Plist.write_to_path(info, path)
    end

    # The targets' Pods-* xcconfigs (also the base configurations of the app's
    # own targets) ask to embed the Swift standard libraries, which iOS 17.6 and
    # later ship with. Xcode recommends removing that.
    installer.aggregate_targets.each do |aggregate|
      aggregate.xcconfigs.each do |config_name, xcconfig|
        xcconfig.attributes.delete 'ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'
        xcconfig.attributes.delete 'EMBEDDED_CONTENT_CONTAINS_SWIFT'
        xcconfig.save_as(aggregate.xcconfig_path(config_name))
      end
    end

    # Xcode's recommended project settings, so it stops offering to update the
    # Pods project; pods are signed with the app, so they need no identity.
    # Left off: user script sandboxing (React Native's, Expo's and Crashlytics'
    # script phases write outside their declared outputs) and the module
    # verifier on the pods themselves (CocoaPods' umbrella headers use quoted
    # includes, which it rejects).
    installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '2720'
    installer.pods_project.root_object.attributes['BuildIndependentTargetsInParallel'] = 'YES'
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS'] = 'YES'
      config.build_settings['STRING_CATALOG_GENERATE_SYMBOLS'] = 'YES'
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings.delete 'STRIP_INSTALLED_PRODUCT'
      config.build_settings.delete 'STRIP_STYLE'
      config.build_settings.delete 'STRIP_SWIFT_SYMBOLS'
      # Xcode's compilation cache (Swift and C-family), kept in each
      # DerivedData's CompilationCache.noindex, as learnX.xcodeproj sets for its
      # own targets. Debug only. ccache doesn't work here: Xcode 26 and later
      # never call React Native's CC wrapper, and with C_COMPILER_LAUNCHER
      # ccache can't cache explicitly built modules.
      config.build_settings['COMPILATION_CACHE_ENABLE_CACHING'] = 'YES' if config.name == 'Debug'
    end
  end
end

# The share extension (ShareExtension/ShareViewController.swift) uses no pods.

# Home screen widgets (expo-widgets). The widget extension only links Expo,
# ExpoUI and ExpoWidgets; see `use_expo_modules_widgets!`. This mirrors what
# the expo-widgets config plugin adds to a prebuild project.
require File.join(File.dirname(`node --print "require.resolve('expo-widgets/package.json')"`), "scripts/autolinking")

target 'ExpoWidgetsTarget' do
  use_expo_modules_widgets!

  config = use_expo_native_module!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    hermes_enabled: true
  )
end
