From 64e4f7f32591cd74d2ef827848bee61cddc9373a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 19:50:44 -0800
Subject: [PATCH] fix(android): run the driver's instrumentation in the shell's
 foreground

Backgrounded with &, the shell adbd starts for am instrument exits at once
and stays a zombie for as long as the session keeps its stream open. On
API 29 emulators Android's llkd kills adbd once a child has been a zombie
for 10 minutes, so every session longer than that lost the device.
---
 .../src/main/java/maestro/drivers/AndroidDriver.kt          | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt b/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt
index 76b89ee7..2f98656d 100644
--- a/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt
@@ -131,7 +131,11 @@ class AndroidDriver(
             append("-e debug false ")
             append("-e class 'dev.mobile.maestro.MaestroDriverService#grpcServer' ")
             append("-e port $port ")
-            append("dev.mobile.maestro.test/androidx.test.runner.AndroidJUnitRunner &\n")
+            // In the foreground: backgrounded, the shell adbd started for it exits at once and stays a
+            // zombie while this session keeps its stream open, and Android's llkd kills adbd once a
+            // child has been a zombie for 10 minutes (API 29 emulators), which drops the device mid-run.
+            // Closing the session's stream still ends the instrumentation.
+            append("dev.mobile.maestro.test/androidx.test.runner.AndroidJUnitRunner\n")
         }
 
         open = true
-- 
