diff --git a/maestro-client/src/main/java/maestro/ViewHierarchy.kt b/maestro-client/src/main/java/maestro/ViewHierarchy.kt
index 67fe3d0..e800198 100644
--- a/maestro-client/src/main/java/maestro/ViewHierarchy.kt
+++ b/maestro-client/src/main/java/maestro/ViewHierarchy.kt
@@ -49,17 +49,44 @@ value class ViewHierarchy(val root: TreeNode) {
         return node == elementAtPosition
     }
 
-    fun refreshElement(node: TreeNode): TreeNode? {
+    /**
+     * Finds [node] again in this hierarchy: the one element with the same attributes, bounds
+     * aside. Look-alikes, such as the switches of a settings page that all read 1 or 0, are told
+     * apart by the ids of the elements around them in [previous], the hierarchy [node] came
+     * from, which a scroll doesn't change.
+     */
+    fun refreshElement(node: TreeNode, previous: ViewHierarchy? = null): TreeNode? {
         val matches = root.aggregate()
             .filter {
                 (it.attributes - "bounds") == (node.attributes - "bounds")
             }
 
-        if (matches.size != 1) {
+        if (matches.size == 1) {
+            return matches[0]
+        }
+        if (matches.isEmpty() || previous == null) {
             return null
         }
 
-        return matches[0]
+        val ids = previous.ancestorIds(node) ?: return null
+        return matches.singleOrNull { ancestorIds(it) == ids }
+    }
+
+    /** The ids of the elements that hold [node], outermost first, or null when it isn't here. */
+    fun ancestorIds(node: TreeNode): List<String>? {
+        return pathTo(root, node)
+            ?.dropLast(1)
+            ?.mapNotNull { it.attributes["resource-id"]?.takeIf(String::isNotBlank) }
+    }
+
+    private fun pathTo(from: TreeNode, node: TreeNode): List<TreeNode>? {
+        if (from === node) {
+            return listOf(from)
+        }
+        for (child in from.children) {
+            pathTo(child, node)?.let { return listOf(from) + it }
+        }
+        return null
     }
 
     fun getElementAt(
diff --git a/maestro-client/src/test/java/maestro/ViewHierarchyTest.kt b/maestro-client/src/test/java/maestro/ViewHierarchyTest.kt
