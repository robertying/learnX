index 0000000..cee00c3
--- /dev/null
+++ b/maestro-client/src/test/java/maestro/ViewHierarchyTest.kt
@@ -0,0 +1,82 @@
+package maestro
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.jupiter.api.Test
+
+internal class ViewHierarchyTest {
+
+    // A settings page whose rows each hold a switch with no id, reading 1 or 0.
+    private fun page(offset: Int): Pair<ViewHierarchy, List<TreeNode>> {
+        val switches = (0 until 3).map { row ->
+            TreeNode(
+                attributes = mutableMapOf(
+                    "text" to "1",
+                    "bounds" to "[786,${row * 52 + offset}][849,${row * 52 + offset + 28}]",
+                ),
+            )
+        }
+        val rows = switches.mapIndexed { row, switch ->
+            TreeNode(
+                attributes = mutableMapOf(
+                    "resource-id" to "row-$row",
+                    "bounds" to "[340,${row * 52 + offset}][867,${row * 52 + offset + 52}]",
+                ),
+                children = listOf(switch),
+            )
+        }
+        val list = TreeNode(
+            attributes = mutableMapOf("resource-id" to "list", "bounds" to "[0,0][951,669]"),
+            children = rows,
+        )
+        return ViewHierarchy(TreeNode(children = listOf(list))) to switches
+    }
+
+    @Test
+    internal fun `finds a unique element again whatever the previous hierarchy`() {
+        val (before, switches) = page(100)
+        val unique = TreeNode(attributes = mutableMapOf("text" to "Done", "bounds" to "[0,0][50,20]"))
+        val after = ViewHierarchy(TreeNode(children = listOf(before.root, unique)))
+
+        assertThat(after.refreshElement(unique.copy(attributes = mutableMapOf("text" to "Done", "bounds" to "[9,9][59,29]"))))
+            .isSameInstanceAs(unique)
+        assertThat(after.refreshElement(switches[0])).isNull()
+    }
+
+    @Test
+    internal fun `tells look-alike elements apart by the ids around them after a scroll`() {
+        val (before, switchesBefore) = page(549)
+        val (after, switchesAfter) = page(603)
+
+        assertThat(after.refreshElement(switchesBefore[2], before)).isSameInstanceAs(switchesAfter[2])
+        assertThat(after.refreshElement(switchesBefore[0], before)).isSameInstanceAs(switchesAfter[0])
+    }
+
+    @Test
+    internal fun `finds nothing when look-alikes share the ids around them`() {
+        val twins = (0 until 2).map {
+            TreeNode(attributes = mutableMapOf("text" to "1", "bounds" to "[0,${it * 40}][10,${it * 40 + 10}]"))
+        }
+        val hierarchy = ViewHierarchy(
+            TreeNode(attributes = mutableMapOf("resource-id" to "list"), children = twins),
+        )
+
+        assertThat(hierarchy.refreshElement(twins[0], hierarchy)).isNull()
+    }
+
+    @Test
+    internal fun `finds nothing for an element that isn't in the previous hierarchy`() {
+        val (before, _) = page(100)
+        val (after, _) = page(200)
+        val stranger = TreeNode(attributes = mutableMapOf("text" to "1", "bounds" to "[0,0][10,10]"))
+
+        assertThat(after.refreshElement(stranger, before)).isNull()
+        assertThat(before.ancestorIds(stranger)).isNull()
+    }
+
+    @Test
+    internal fun `lists the ids that hold an element, outermost first`() {
+        val (hierarchy, switches) = page(100)
+
+        assertThat(hierarchy.ancestorIds(switches[1])).containsExactly("list", "row-1").inOrder()
+    }
+}
diff --git a/maestro-orchestra/src/main/java/maestro/orchestra/Orchestra.kt b/maestro-orchestra/src/main/java/maestro/orchestra/Orchestra.kt
