@@ -1566,7 +1566,9 @@ class Orchestra(
                     debugMessage = childOfDebugMessage
                 )
             }
-            return FindElementResult(found, ViewHierarchy(found.treeNode))
+            // The whole screen it was found on, as without childOf: a tap compares it with the
+            // screen afterwards and finds the element in it again, by the ids around it.
+            return FindElementResult(found, fullHierarchy)
         }
 
 
