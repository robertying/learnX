-            let viewHierarchy = ViewHierarchy.init(axElement: appViewHierarchy, depth: appViewHierarchy.depth())
+            let (appViewHierarchy, pendingTap) = try await getAppViewHierarchy(foregroundApp: foregroundApp, excludeKeyboardElements: requestBody.excludeKeyboardElements)
+            let viewHierarchy = ViewHierarchy.init(axElement: appViewHierarchy, depth: appViewHierarchy.depth(), pendingTap: pendingTap)
             
             NSLog("[Done] View hierarchy snapshot for \(foregroundApp) ")
             let body = try JSONEncoder().encode(viewHierarchy)
@@ -44,17 +44,72 @@ struct ViewHierarchyHandler: HTTPHandler {
         }
     }
 
-    func getAppViewHierarchy(foregroundApp: XCUIApplication, excludeKeyboardElements: Bool) async throws -> AXElement {
+    /// The app's hierarchy, and a point for the caller to tap that the runner can't: the button
+    /// answering a permission request on a display other than the main one.
+    func getAppViewHierarchy(foregroundApp: XCUIApplication, excludeKeyboardElements: Bool) async throws -> (AXElement, AXFrame?) {
         let hierarchy = try await getAppAndBarsHierarchy(foregroundApp: foregroundApp, excludeKeyboardElements: excludeKeyboardElements)
-        guard let alert = springboardAlert(over: foregroundApp) else {
-            return hierarchy
+        guard var alert = springboardAlert(over: foregroundApp) else {
+            return (hierarchy, nil)
         }
         // An alert SpringBoard shows over the app (an app asking to send notifications, Save
         // Password) isn't in the app's tree, and the app stays the foreground app meanwhile. Add
         // it last, on top, as it is on screen, and answer a permission request as the flow set.
         NSLog("Adding the SpringBoard alert over \(foregroundApp.bundleID)")
-        await SystemPermissionHelper.handleSystemPermissionAlertIfNeeded(appHierarchy: alert, foregroundApp: springboardApplication)
-        return AXElement(children: [hierarchy, alert])
+        guard ScreenSizeHelper.foregroundAppOtherDisplayID() != nil else {
+            await SystemPermissionHelper.handleSystemPermissionAlertIfNeeded(appHierarchy: alert, foregroundApp: springboardApplication)
+            return (AXElement(children: [hierarchy, alert]), nil)
+        }
+        // On another display (the open iPhone Duo's inner one), SpringBoard reports the alert in
+        // that display's unrotated, portrait points while the app is in landscape, and events the
+        // runner synthesizes land on the main display. Put the alert where the app's frames are,
+        // and leave the tap answering it to the caller.
+        if let width = landscapeWidth(of: hierarchy) {
+            alert = rotatedQuarterTurn(alert, width: width)
+        }
+        let tap = SystemPermissionHelper.permissionButtonFrame(in: alert)
+        return (AXElement(children: [hierarchy, alert]), tap)
+    }
+
+    /// The width of the app's widest window when that window is in landscape, else nil.
+    private func landscapeWidth(of hierarchy: AXElement) -> Double? {
+        func windows(_ element: AXElement) -> [AXFrame] {
+            element.elementType == Int(XCUIElement.ElementType.window.rawValue)
+                ? [element.frame] : (element.children ?? []).flatMap(windows)
+        }
+        guard let window = windows(hierarchy).max(by: { ($0["Width"] ?? 0) < ($1["Width"] ?? 0) }),
+              let width = window["Width"], let height = window["Height"], width > height else {
+            return nil
+        }
+        return width
+    }
+
+    /// Frames in a display's unrotated points, turned a quarter turn as the open iPhone Duo's
+    /// inner display shows them: a point (x, y) is at (width - y, x) in landscape.
+    private func rotatedQuarterTurn(_ element: AXElement, width: Double) -> AXElement {
+        let x = element.frame["X"] ?? 0, y = element.frame["Y"] ?? 0
+        let w = element.frame["Width"] ?? 0, h = element.frame["Height"] ?? 0
+        return copy(element, frame: ["X": width - y - h, "Y": x, "Width": h, "Height": w],
+                    children: element.children?.map { rotatedQuarterTurn($0, width: width) } ?? [])
+    }
+
+    private func copy(_ element: AXElement, frame: AXFrame, children: [AXElement]) -> AXElement {
+        AXElement(
+            identifier: element.identifier,
+            frame: frame,
+            value: element.value,
+            title: element.title,
+            label: element.label,
+            elementType: element.elementType,
+            enabled: element.enabled,
+            horizontalSizeClass: element.horizontalSizeClass,
+            verticalSizeClass: element.verticalSizeClass,
+            placeholderValue: element.placeholderValue,
+            selected: element.selected,
+            hasFocus: element.hasFocus,
+            displayID: element.displayID,
+            windowContextID: element.windowContextID,
+            children: children
+        )
     }
 
     private func springboardAlert(over app: XCUIApplication) -> AXElement? {
diff --git a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/Helpers/SystemPermissionHelper.swift b/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/Helpers/SystemPermissionHelper.swift
index 69cf5811..be59ccdb 100644
--- a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/Helpers/SystemPermissionHelper.swift
+++ b/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/Helpers/SystemPermissionHelper.swift
@@ -37,6 +37,21 @@ final class SystemPermissionHelper {
         NSLog("[Done] Foreground app is springboard attempting to tap on permissions dialog")
     }
 
+    /// The frame of the button answering a notifications request in `alert` as the flow's
+    /// permissions say, for a caller that taps it itself; nil when there is nothing to tap.
+    static func permissionButtonFrame(in alert: AXElement) -> AXFrame? {
+        guard let data = UserDefaults.standard.object(forKey: "permissions") as? Data,
+              let permissions = try? JSONDecoder().decode([String : PermissionValue].self, from: data),
+              let notificationsPermission = permissions.first(where: { $0.key == "notifications" }) else {
+            return nil
+        }
+        if case .found(let frame) = buttonFinder.findButtonToTap(for: notificationsPermission.value, in: alert) {
+            NSLog("Leaving the tap on the permission button at \(frame) to the caller")
+            return frame
+        }
+        return nil
+    }
+
     /// Tap at the center of an element's frame
     private static func tapAtCenter(of frame: AXFrame, in app: XCUIApplication) async {
         let x = frame.centerX
diff --git a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/Models/AXElement.swift b/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/Models/AXElement.swift
index 54b7879b..2f219f92 100644
--- a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/Models/AXElement.swift
