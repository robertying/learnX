From b597afc031307e9086dc80643f7805e942e2f9c7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 16:34:14 -0800
Subject: [PATCH] fix(ios): place and answer a SpringBoard alert on another
 display

On the open iPhone Duo, SpringBoard reports an alert over the app in the
inner display's unrotated portrait points while the app is in landscape,
and the events the runner synthesizes land on the main display, so the
alert sat in the wrong place and a notifications request was tapped
beside its button. Turn the alert's frames a quarter turn into the app's
landscape points, and have the runner leave the tap answering a
permission request to the driver, which sends it through the touch
helper (MAESTRO_IOS_SIM_TOUCH) and reads the screen again.
---
 .../main/java/maestro/drivers/IOSDriver.kt    | 10 ++-
 .../src/main/kotlin/hierarchy/AXElement.kt    |  5 +-
 .../Handlers/ViewHierarchyHandler.swift       | 69 +++++++++++++++++--
 .../Helpers/SystemPermissionHelper.swift      | 15 ++++
 .../Routes/Models/AXElement.swift             |  3 +
 5 files changed, 93 insertions(+), 9 deletions(-)

diff --git a/maestro-client/src/main/java/maestro/drivers/IOSDriver.kt b/maestro-client/src/main/java/maestro/drivers/IOSDriver.kt
index ab304b71..649357b1 100644
--- a/maestro-client/src/main/java/maestro/drivers/IOSDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/IOSDriver.kt
@@ -205,7 +205,15 @@ class IOSDriver(
     }
 
     private fun viewHierarchy(excludeKeyboardElements: Boolean): TreeNode {
-        val hierarchyResult = iosDevice.viewHierarchy(excludeKeyboardElements)
+        var hierarchyResult = iosDevice.viewHierarchy(excludeKeyboardElements)
+        // The runner leaves a permission request on another display for us to answer
+        // (simTouch); read the screen again once the alert has gone.
+        repeat(2) {
+            val tap = hierarchyResult.pendingTap ?: return@repeat
+            if (simTouch?.send("tap ${tap.x + tap.width / 2} ${tap.y + tap.height / 2}") != true) return@repeat
+            Thread.sleep(500)
+            hierarchyResult = iosDevice.viewHierarchy(excludeKeyboardElements)
+        }
         if (hierarchyResult.depth > WARNING_MAX_DEPTH) {
             val message = "The view hierarchy has been calculated. The current depth of the hierarchy " +
                     "is ${hierarchyResult.depth}. This might affect the execution time of your test. " +
