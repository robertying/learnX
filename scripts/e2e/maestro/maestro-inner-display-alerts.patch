@@ -6,6 +6,9 @@ import MaestroDriverLib
 struct ViewHierarchy : Codable {
     let axElement: AXElement
     let depth: Int
+    /// A point the caller should tap, since the runner's events can't reach it: a permission
+    /// request's button on a display other than the main one.
+    var pendingTap: AXFrame? = nil
 }
 
