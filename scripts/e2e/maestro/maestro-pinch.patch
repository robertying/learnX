diff --git a/maestro-client/src/test/java/maestro/PinchSpansTest.kt b/maestro-client/src/test/java/maestro/PinchSpansTest.kt
new file mode 100644
index 0000000..db7637e
--- /dev/null
+++ b/maestro-client/src/test/java/maestro/PinchSpansTest.kt
@@ -0,0 +1,42 @@
+package maestro
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+
+class PinchSpansTest {
+
+    private val center = Point(500, 1000)
+
+    @Test
+    fun `zooming in spreads the fingers to 40 percent of the shorter side`() {
+        assertThat(pinchSpans(center, width = 1000, height = 2000, scale = 2.0)).isEqualTo(200 to 400)
+    }
+
+    @Test
+    fun `zooming out brings them together from there`() {
+        assertThat(pinchSpans(center, width = 1000, height = 2000, scale = 0.25)).isEqualTo(400 to 100)
+    }
+
+    @Test
+    fun `fingers stay at least a tenth of the wider span apart`() {
+        assertThat(pinchSpans(center, width = 1000, height = 2000, scale = 20.0)).isEqualTo(40 to 400)
+        assertThat(pinchSpans(center, width = 1000, height = 2000, scale = 0.01)).isEqualTo(400 to 40)
+    }
+
+    @Test
+    fun `fingers stay around a point near a side edge`() {
+        assertThat(pinchSpans(Point(100, 1000), width = 1000, height = 2000, scale = 2.0)).isEqualTo(90 to 180)
+        assertThat(pinchSpans(Point(950, 1000), width = 1000, height = 2000, scale = 2.0)).isEqualTo(45 to 90)
+    }
+
+    @Test
+    fun `a scale of 1 doesn't move them`() {
+        assertThat(pinchSpans(center, width = 1000, height = 2000, scale = 1.0)).isEqualTo(400 to 400)
+    }
+
+    @Test
+    fun `a scale must be above 0`() {
+        assertThrows<IllegalArgumentException> { pinchSpans(center, width = 1000, height = 2000, scale = 0.0) }
+    }
+}
