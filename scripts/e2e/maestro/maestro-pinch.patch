new file mode 100644
index 0000000..2fd70e9
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/PinchSpans.kt
@@ -0,0 +1,20 @@
+package maestro
+
+import kotlin.math.roundToInt
+
+/**
+ * How far apart two fingers, side by side, start and end a pinch around [center] that scales what is under them by
+ * [scale], on a screen [width] by [height] pixels. The wider span is 40% of the shorter side, and less near a side
+ * edge, so that both fingers land around [center] (in a split view, inside its pane). The narrower one is at least a
+ * tenth of the wider, so a scale beyond 10 (or under 1/10) pinches only that far.
+ */
+fun pinchSpans(center: Point, width: Int, height: Int, scale: Double): Pair<Int, Int> {
+    require(scale > 0) { "A pinch's scale must be above 0: $scale" }
+    val wide = minOf(minOf(width, height) * 0.4, minOf(center.x, width - center.x) * 2 * 0.9)
+    val narrow = maxOf(wide / 10, wide / maxOf(scale, 1 / scale))
+    return if (scale >= 1) {
+        narrow.roundToInt() to wide.roundToInt()
+    } else {
+        wide.roundToInt() to narrow.roundToInt()
+    }
+}
