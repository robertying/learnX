+        val deviceInfo = runInterruptible(Dispatchers.IO) { driver.deviceInfo() }
+        pinch(center, scale, durationMs, deviceInfo)
+    }
+
+    private suspend fun pinch(center: Point, scale: Double, durationMs: Long, deviceInfo: DeviceInfo) {
+        val (startSpan, endSpan) = pinchSpans(center, deviceInfo.widthGrid, deviceInfo.heightGrid, scale)
+        LOGGER.info("Pinching at $center from $startSpan to $endSpan over ${durationMs}ms")
+
+        runInterruptible(Dispatchers.IO) { driver.pinch(center, startSpan, endSpan, durationMs) }
+
+        waitForAppToSettle()
+    }
