+     * [scale]: above 1 zooms in, below 1 zooms out.
+     */
+    suspend fun pinch(percentX: Int, percentY: Int, scale: Double, durationMs: Long) {
+        val deviceInfo = runInterruptible(Dispatchers.IO) { driver.deviceInfo() }
+        val center = Point(deviceInfo.widthGrid * percentX / 100, deviceInfo.heightGrid * percentY / 100)
