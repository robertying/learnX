+    private suspend fun pinchCommand(command: PinchCommand): Boolean {
+        val point = command.point ?: "50%,50%"
+        val duration = command.duration ?: DEFAULT_PINCH_DURATION_MS
+
+        if (point.contains("%")) {
+            val (percentX, percentY) = NumericFields.parsePoint(point)
+            if (percentX !in 0..100 || percentY !in 0..100) {
+                throw MaestroException.InvalidCommand("Invalid point: $point")
+            }
+            maestro.pinch(percentX, percentY, command.scale, duration)
+        } else {
+            val (x, y) = NumericFields.parsePoint(point)
+            if (x < 0 || y < 0) {
+                throw MaestroException.InvalidCommand("Invalid point: $point. Coordinates must not be negative.")
+            }
+            maestro.pinch(Point(x, y), command.scale, duration)
+        }
+
+        return true
+    }
