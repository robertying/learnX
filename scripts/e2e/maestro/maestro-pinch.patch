@@ -0,0 +1,13 @@
+package maestro.orchestra.yaml
+
+/**
+ * `pinch: {scale, point, duration}`: two fingers pinch around [point] ("50%,50%" by default, or pixels as "x,y") over
+ * [duration] milliseconds, so that what is under them scales by [scale]: 2, zooming in, by default.
+ */
+data class YamlPinch(
+    val scale: Double = 2.0,
+    val point: String? = null,
+    val duration: Long? = null,
+    val label: String? = null,
+    val optional: Boolean = false,
+)
