+    override fun pinch(
+        request: MaestroAndroid.PinchRequest,
+        responseObserver: StreamObserver<MaestroAndroid.PinchResponse>
+    ) {
+        try {
+            val y = request.centerY
+            val startHalf = request.startSpan / 2
+            val endHalf = request.endSpan / 2
+            // UiAutomator moves the pointers one step every 5 ms.
+            val steps = maxOf(1, request.durationMs / 5)
+            UiObject(UiSelector()).performTwoPointerGesture(
+                Point(request.centerX - startHalf, y),
+                Point(request.centerX + startHalf, y),
+                Point(request.centerX - endHalf, y),
+                Point(request.centerX + endHalf, y),
+                steps,
+            )
+
+            responseObserver.onNext(pinchResponse {})
+            responseObserver.onCompleted()
+        } catch (t: Throwable) {
+            responseObserver.onError(t.internalError())
+        }
+    }
+
