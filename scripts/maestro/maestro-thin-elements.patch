From 881c2d2c643072f003407f978643c23e5ef68af9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 01:50:15 -0800
Subject: [PATCH] fix: treat an element no wider or taller than a point as
 not visible

UIKit leaves a bar button that a compact layout moved to another bar (the
iPhone Duo closed, whose bars sit at the right) where it was, one point
wide. Maestro matched it first and tapped it, which did nothing.
---
 .../src/main/java/maestro/UiElement.kt          |  5 ++++-
 .../src/test/java/maestro/UiElementTest.kt      | 17 ++++++++++++++++-
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/maestro-client/src/main/java/maestro/UiElement.kt b/maestro-client/src/main/java/maestro/UiElement.kt
index 36b148d6..ba3c386c 100644
--- a/maestro-client/src/main/java/maestro/UiElement.kt
+++ b/maestro-client/src/main/java/maestro/UiElement.kt
@@ -29,7 +29,10 @@ data class UiElement(
     }
 
     fun getVisiblePercentage(screenWidth: Int, screenHeight: Int): Double {
-        if (bounds.width == 0 && bounds.height == 0) {
+        // A view no wider or taller than a point can't be seen or tapped:
+        // UIKit leaves a bar button that a compact layout moved to another
+        // bar (iPhone Duo closed) where it was, one point wide.
+        if (bounds.width <= 1 || bounds.height <= 1) {
             return 0.0
         }
 
diff --git a/maestro-client/src/test/java/maestro/UiElementTest.kt b/maestro-client/src/test/java/maestro/UiElementTest.kt
index 6c1d694f..5bc57f04 100644
--- a/maestro-client/src/test/java/maestro/UiElementTest.kt
+++ b/maestro-client/src/test/java/maestro/UiElementTest.kt
@@ -68,4 +68,19 @@ internal class UiElementTest {
         val percent = element.getVisiblePercentage(screenWidth, screenHeight)
         assertThat(percent).isEqualTo(0)
     }
-}
\ No newline at end of file
+
+    @Test
+    internal fun `check visible percentage on screen - a line is not visible`() {
+        val element = UiElement(
+            TreeNode(),
+            bounds = Bounds(
+                x = 358,
+                y = 24,
+                width = 1,
+                height = 58
+            )
+        )
+        val percent = element.getVisiblePercentage(screenWidth, screenHeight)
+        assertThat(percent).isEqualTo(0)
+    }
+}
-- 
