+
+
+/// Where the foreground app sits on screen.
+///
+/// Two layouts break the assumption that the app fills SpringBoard's frame:
+///  - The app is on another display than the main one, for example the inner display of a
+///    foldable iPhone simulator that is open. Its frames are in that display's coordinates,
+///    and events synthesized through the runner daemon land on the main display.
+///  - The app is in a window smaller than the screen (iPadOS windowed apps). Its frames are
+///    already in screen coordinates.
+enum DisplayHelper {
+
+    /// The display XCUIScreen.main renders, or nil when XCTest doesn't expose it.
+    static func mainDisplayID() -> Int? {
+        let screen = XCUIScreen.main as NSObject
+        guard screen.responds(to: NSSelectorFromString("displayID")) else {
+            return nil
+        }
+        return (screen.value(forKey: "displayID") as? NSNumber)?.intValue
+    }
+
+    /// The display of the first element in the hierarchy that reports one.
+    static func displayID(of element: AXElement) -> Int? {
+        if element.displayID != 0 {
+            return element.displayID
+        }
+        for child in element.children ?? [] {
+            if let id = displayID(of: child) {
+                return id
+            }
+        }
+        return nil
+    }
+
+    /// True when the element is on a display other than the main one.
+    static func isOnOtherDisplay(_ element: AXElement) -> Bool {
+        guard let appDisplay = displayID(of: element), let mainDisplay = mainDisplayID() else {
+            return false
+        }
+        return appDisplay != mainDisplay
+    }
+
+    /// True when the app frame doesn't start at the screen origin, so it is a window whose
+    /// frames XCTest already reports in screen coordinates.
+    static func isWindowed(appFrame: AXFrame) -> Bool {
+        let x = appFrame["X"] ?? 0
+        let y = appFrame["Y"] ?? 0
+        return abs(x) >= 1.0 || abs(y) >= 1.0
+    }
+
+    /// The screen that shows the given display, falling back to the main screen.
+    static func screen(for displayID: Int?) -> XCUIScreen {
+        guard let displayID = displayID else {
+            return XCUIScreen.main
+        }
+        return XCUIScreen.screens.first { screen in
+            let object = screen as NSObject
+            guard object.responds(to: NSSelectorFromString("displayID")) else {
+                return false
+            }
+            return (object.value(forKey: "displayID") as? NSNumber)?.intValue == displayID
+        } ?? XCUIScreen.main
+    }
+}
