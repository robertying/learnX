--- a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/RunningApp.swift
+++ b/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/RunningApp.swift
@@ -34,9 +34,34 @@ struct RunningApp {
         // a splash screen). Snapshotting it then throws "Application ... is not running", which callers
         // escalate as a fatal AppCrash. Returning nil instead lets callers fall back to the springboard hierarchy
         // and retry.
-        return runningAppIds
+        let foregroundApps = runningAppIds
             .map { XCUIApplication(bundleIdentifier: $0) }
-            .first { $0.state == .runningForeground }
+            .filter { $0.state == .runningForeground }
+        let foregroundAppIds = foregroundApps.compactMap { $0.bundleID }
+
+        // Remember the app that most recently became active: that is the one a flow launched.
+        for appId in runningAppIds where appId != springboardBundleId && !lastActiveAppIds.contains(appId) {
+            newestAppId = appId
+        }
+        lastActiveAppIds = Set(runningAppIds)
+
+        // With iPadOS windowed apps, several apps are in the foreground at once (and an app in a
+        // window can drop out of activeAppsInfo() while it is on screen). The first one listed
+        // isn't necessarily the one under test, so prefer the newest app while it is in the
+        // foreground.
+        let otherApps = foregroundAppIds.filter { $0 != springboardBundleId }
+        if otherApps.count != 1, let newestAppId = newestAppId {
+            let newestApp = XCUIApplication(bundleIdentifier: newestAppId)
+            if newestApp.state == .runningForeground {
+                NSLog("Using the newest foreground app \(newestAppId) among \(otherApps)")
+                return newestApp
+            }
+        }
+
+        return foregroundApps.first
     }
+
+    private static var newestAppId: String?
+    private static var lastActiveAppIds: Set<String> = []
     
 }
